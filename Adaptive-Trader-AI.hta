<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=11" />
<meta charset="utf-8" />
<title>Adaptive Trader V3.0.4</title>
<hta:application id="app" applicationname="Adaptive Trader V3.0.4" border="thin" caption="yes" maximizebutton="yes" minimizebutton="yes" scroll="yes" singleinstance="yes" sysmenu="yes" windowstate="maximize" />
<style>
*{box-sizing:border-box}body{margin:0;font-family:"Segoe UI",Arial,sans-serif;background:#f4f7fb;color:#162033;font-size:15px}button,input,select{font:inherit}.shell{min-height:100vh}.top{height:72px;background:#10233f;color:white;display:flex;align-items:center;padding:0 24px;position:fixed;top:0;left:0;right:0;z-index:5}.brand{font-size:21px;font-weight:700}.brand small{display:block;color:#9fb4d1;font-size:11px;font-weight:400;letter-spacing:.8px}.topright{margin-left:auto;display:flex;align-items:center;gap:12px}.badge{padding:7px 11px;border-radius:20px;background:#263b59;font-size:12px}.badge.ok{background:#146c53}.toggle{background:#fff;color:#10233f;border:0;border-radius:7px;padding:9px 13px;cursor:pointer}.side{position:fixed;top:72px;bottom:0;left:0;width:216px;background:#fff;border-right:1px solid #dfe6ef;padding:17px 10px;z-index:4}.nav{display:block;width:100%;text-align:left;border:0;background:transparent;padding:12px 14px;border-radius:8px;color:#435069;cursor:pointer;margin:3px 0}.nav:hover,.nav.active{background:#eaf2ff;color:#175fc0;font-weight:600}.main{margin-left:216px;padding:96px 26px 36px;max-width:1450px}.page{display:none}.page.active{display:block}.eyebrow{color:#617089;font-size:13px}.heading{font-size:27px;margin:4px 0 6px}.sub{color:#66748a;margin:0 0 22px;line-height:1.5}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.card{background:#fff;border:1px solid #e0e7f0;border-radius:12px;padding:18px;box-shadow:0 2px 7px rgba(20,40,70,.04)}.span3{grid-column:span 3}.span4{grid-column:span 4}.span5{grid-column:span 5}.span6{grid-column:span 6}.span7{grid-column:span 7}.span8{grid-column:span 8}.span12{grid-column:span 12}.metric{font-size:27px;font-weight:700;margin:8px 0}.muted{color:#718097}.green{color:#147d5b}.red{color:#b94040}.blue{color:#176ac2}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.space{justify-content:space-between}.btn{border:0;background:#176ac2;color:#fff;padding:10px 15px;border-radius:8px;cursor:pointer}.btn.secondary{background:#edf3fb;color:#24598f}.btn.danger{background:#b94040}.btn.small{padding:6px 10px;font-size:12px}.input{padding:10px 12px;border:1px solid #ccd6e3;border-radius:7px;background:white}.wide{width:100%}.score{width:72px;height:72px;border-radius:50%;background:#e9f3ff;color:#176ac2;display:flex;align-items:center;justify-content:center;font-size:25px;font-weight:700;border:5px solid #c4ddf7}.stock{border-top:1px solid #e6ebf2;padding:14px 0}.stock:first-child{border-top:0}.pill{font-size:12px;padding:5px 9px;border-radius:14px;background:#edf3fb;color:#385673}.pill.good{background:#e1f5ee;color:#167253}.pill.warn{background:#fff3dc;color:#8b5b00}.why{background:#f6f9fd;border-left:3px solid #72a8dc;padding:11px 13px;border-radius:4px;line-height:1.55;margin-top:12px}.help{border:0;background:none;color:#176ac2;text-decoration:underline;cursor:pointer;padding:0}.steps{display:flex;margin-bottom:18px}.step{flex:1;border-bottom:4px solid #dce4ee;padding:8px;color:#7b8798}.step.on{border-color:#176ac2;color:#176ac2;font-weight:600}.preset{display:inline-block;width:31%;vertical-align:top;border:2px solid #dce4ee;border-radius:10px;padding:14px;margin-right:2%;cursor:pointer}.preset.selected{border-color:#176ac2;background:#f0f6ff}.preset:last-child{margin-right:0}.notice{background:#fff8e8;border:1px solid #f1d593;padding:12px;border-radius:8px;color:#735819}.advanced-only{display:none}.advanced .advanced-only{display:block}.advanced .advanced-only.inline{display:inline-block}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #e5ebf2}th{color:#65738a;font-size:12px;text-transform:uppercase}.factorbar{height:8px;background:#e5ebf2;border-radius:8px;overflow:hidden;margin-top:5px}.factorbar i{display:block;height:100%;background:#3e91d8}.modalbg{display:none;position:fixed;inset:0;background:rgba(11,25,44,.55);z-index:20}.modal{background:#fff;width:520px;max-width:90%;margin:10vh auto;padding:24px;border-radius:12px;box-shadow:0 15px 45px rgba(0,0,0,.2)}.modal h2{margin-top:0}.lesson{border:1px solid #dfe6ef;border-radius:9px;padding:14px;margin-bottom:10px}.empty{text-align:center;padding:30px;color:#728096}.statusdot{width:9px;height:9px;border-radius:50%;display:inline-block;background:#94a0b0;margin-right:5px}.statusdot.live{background:#2ab37c}.footer{margin-top:30px;color:#8290a2;font-size:12px;text-align:center}@media(max-width:900px){.side{width:165px}.main{margin-left:165px}.span3,.span4,.span5,.span6,.span7,.span8{grid-column:span 12}.preset{display:block;width:100%;margin:8px 0}.top{padding:0 12px}.badge{display:none}}
/* Accessibility size update */
body{font-size:17px}.top{height:80px}.brand{font-size:24px}.brand small{font-size:12px}.badge{font-size:13px;padding:8px 12px}.toggle{padding:10px 14px}.side{top:80px;width:235px}.nav{font-size:17px;padding:14px 15px}.main{margin-left:235px;padding:105px 28px 36px}.eyebrow{font-size:14px}.heading{font-size:31px}.sub{line-height:1.55}.card{padding:20px}.metric{font-size:31px}.btn{padding:11px 17px}.btn.small{font-size:13px;padding:7px 11px}.input{padding:11px 13px}.score{width:80px;height:80px;font-size:28px}.pill{font-size:13px;padding:6px 10px}.why{padding:13px 14px;line-height:1.6}.preset{padding:16px}th,td{padding:12px}th{font-size:13px}.lesson{padding:16px;margin-bottom:12px}.modal{width:570px;padding:27px}.footer{font-size:13px}@media(max-width:900px){.side{width:180px}.main{margin-left:180px}}
/* HTA-compatible layout: IE's renderer does not support modern CSS Grid. */
html,body{width:100%;min-height:100%;overflow-x:hidden}body{font-size:16px;padding-left:235px}.main{margin-left:0;width:100%;min-width:0;padding:105px 28px 36px}.grid{display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;margin:-9px}.grid>.card{margin:9px}.span3{width:calc(25% - 18px)}.span4{width:calc(33.333% - 18px)}.span5{width:calc(41.666% - 18px)}.span6{width:calc(50% - 18px)}.span7{width:calc(58.333% - 18px)}.span8{width:calc(66.666% - 18px)}.span12{width:calc(100% - 18px)}.brand small{font-size:14px}.badge,.btn.small,.pill,th,.footer{font-size:14px}.eyebrow{font-size:14px}.nav{font-size:16px}.help{font-size:16px}.input,.btn{font-size:16px}.card{min-width:0}@media(max-width:1000px){body{padding-left:180px}.side{width:180px}.main{margin-left:0;padding-left:20px;padding-right:20px}.span3,.span4,.span5,.span6,.span7,.span8{width:calc(100% - 18px)}}
/* Keep the page title clear of the always-visible toolbar in the HTA window. */
.page{padding-top:52px}.page.active{padding-top:52px}
/* Large-print mode: all visible text is at least 24 points. */
body,button,input,select,textarea,.nav,.badge,.btn,.btn.small,.pill,th,td,.footer,.eyebrow,.help,.brand small{font-size:24pt!important}.brand{font-size:30pt!important}.heading,.metric{font-size:32pt!important}.score{width:132px;height:132px;font-size:34pt!important;border-width:6px}.top{height:auto;min-height:138px;flex-wrap:wrap;padding:14px 28px}.topright{flex-wrap:wrap}.side{top:138px;width:310px;padding:20px 12px}.nav{padding:18px 20px;line-height:1.2}.main{padding:190px 34px 44px}body{padding-left:310px}.card{padding:24px}.grid{margin:-11px}.grid>.card{margin:11px}.span3{width:calc(25% - 22px)}.span4{width:calc(33.333% - 22px)}.span5{width:calc(41.666% - 22px)}.span6{width:calc(50% - 22px)}.span7{width:calc(58.333% - 22px)}.span8{width:calc(66.666% - 22px)}.span12{width:calc(100% - 22px)}.why,.notice{line-height:1.65;padding:18px}.input{min-height:58px}.btn{min-height:58px}.modal{width:900px;max-width:94%;padding:32px}.page,.page.active{padding-top:56px}@media(max-width:1500px){.span3,.span4,.span5,.span6,.span7,.span8{width:calc(100% - 22px)}.badge{display:none}}@media(max-width:1000px){body{padding-left:250px}.side{width:250px}.main{padding-left:24px;padding-right:24px}.top{min-height:160px}.side{top:160px}}
/* 20-point reading size override. */
body,button,input,select,textarea,.nav,.badge,.btn,.btn.small,.pill,th,td,.footer,.eyebrow,.help,.brand small{font-size:20pt!important}.brand{font-size:26pt!important}.heading,.metric{font-size:28pt!important}.score{width:120px;height:120px;font-size:30pt!important}
/* Comfortable narrow-window layout: content gets the full width; navigation opens on demand. */
.menu-toggle{display:none}@media(max-width:1200px){body{padding-left:0!important}.main{margin-left:0!important;padding-left:38px!important;padding-right:38px!important}.side{display:none}.menu-toggle{display:inline-block}.shell.nav-open .side{display:block;position:fixed;top:210px;bottom:0;left:0;width:370px;max-width:88%;z-index:40;overflow-y:auto;box-shadow:8px 0 25px rgba(10,25,45,.28);border-right:1px solid #dfe6ef}.topright{gap:12px}.page,.page.active{padding-top:44px}}@media(max-width:700px){.top{min-height:286px;padding:14px 18px}.topright{width:100%;margin-left:0}.topright .toggle{margin:3px 0}.main{padding-top:330px!important;padding-left:24px!important;padding-right:24px!important}.shell.nav-open .side{top:286px;width:100%;max-width:100%}.brand{font-size:24pt!important}.heading,.metric{font-size:26pt!important}.card{padding:20px}.page,.page.active{padding-top:32px}}
/* Historical-market controls use stacked labels and responsive fields so large text never overlaps. */
.sim-form{display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;align-items:flex-end;margin:20px -9px 0}.sim-field,.sim-actions{min-width:0;margin:0 9px 18px;-ms-flex:1 1 300px;flex:1 1 300px}.sim-field label,.sim-custom label{display:block;font-weight:600;margin:0 0 7px;line-height:1.25}.sim-field .input{width:100%!important;max-width:100%}.sim-universe{-ms-flex-preferred-size:460px;flex-basis:460px}.sim-time{-ms-flex-preferred-size:310px;flex-basis:310px}.sim-actions{display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;align-items:flex-end;-ms-flex-preferred-size:620px;flex-basis:620px}.sim-actions .btn{margin:0 10px 10px 0;white-space:normal}.sim-custom{margin-top:2px}.sim-custom .input{margin-top:7px}@media(max-width:1350px){.sim-universe,.sim-field,.sim-time,.sim-actions{-ms-flex-preferred-size:calc(50% - 18px);flex-basis:calc(50% - 18px)}.sim-actions{-ms-flex-preferred-size:calc(100% - 18px);flex-basis:calc(100% - 18px)}}@media(max-width:760px){.sim-universe,.sim-field,.sim-time,.sim-actions{-ms-flex-preferred-size:calc(100% - 18px);flex-basis:calc(100% - 18px)}.sim-field label{white-space:normal}.sim-actions .btn{width:100%;margin-right:0}}
/* Comfortable reading spacing at every text size. */
body{line-height:1.5}.top{padding-top:15px!important;padding-bottom:15px!important}.brand{line-height:1.2}.brand small{line-height:1.35;margin-top:4px}.nav{line-height:1.35;margin-top:6px;margin-bottom:6px}.heading{line-height:1.22;margin-top:0;margin-bottom:15px}.sub{line-height:1.6;margin-bottom:28px}.card{line-height:1.5}.card p{margin-top:13px;margin-bottom:13px}.card b{line-height:1.35}.row{row-gap:14px}.btn,.input,.toggle{line-height:1.3}.why,.notice{line-height:1.7}.footer{line-height:1.5;padding-top:8px;padding-bottom:14px}#simulationResult{overflow-x:auto}
</style>
</head>
<body>
<div class="shell" id="shell">
 <div class="top"><div class="brand">Adaptive Trader <span style="color:#76b8ff">V3.0.4</span><small>LEARN • RESEARCH • PAPER TRADE</small></div><div class="topright"><span class="badge" id="dataBadge"><span class="statusdot"></span> Demo data</span><span class="badge">Paper trading only</span><button class="toggle menu-toggle" onclick="toggleNav()" id="navBtn">Menu</button><button class="toggle" onclick="checkForUpdates()">Check for Updates</button><button class="toggle" onclick="toggleAdvanced()" id="modeBtn">Beginner Mode</button></div></div>
 <div class="side" id="sideNav">
  <button class="nav active" data-page="home" onclick="go('home',this)">⌂ &nbsp; Home</button>
  <button class="nav" data-page="explore" onclick="go('explore',this)">⌕ &nbsp; Explore</button>
  <button class="nav" data-page="stocks" onclick="go('stocks',this)">★ &nbsp; My Stocks</button>
  <button class="nav" data-page="paper" onclick="go('paper',this)">⇄ &nbsp; Paper Trading</button>
  <button class="nav" data-page="learn" onclick="go('learn',this)">? &nbsp; Learn</button>
  <button class="nav" data-page="settings" onclick="go('settings',this)">⚙ &nbsp; Settings</button>
  <div class="advanced-only"><hr style="border:0;border-top:1px solid #e3e9f1;margin:14px 5px"><div class="eyebrow" style="padding:5px 14px">ADVANCED RESEARCH</div><button class="nav" data-page="advanced" onclick="go('advanced',this)">▦ &nbsp; Research Lab</button></div>
 </div>
 <main class="main">
  <section class="page active" id="page-home"><div class="eyebrow">BEGINNER DASHBOARD</div><h1 class="heading">Good <span id="daypart">day</span></h1><p class="sub">A simple view of your paper portfolio and watchlist. Scores are research signals—not predictions or financial advice.</p>
   <div class="grid"><div class="card span3"><div class="muted">Paper portfolio</div><div class="metric" id="portfolioValue">$100,000.00</div><span class="pill">Simulated money</span></div><div class="card span3"><div class="muted">Today's change</div><div class="metric green" id="dailyChange">$0.00</div><span class="help" onclick="help('daily')">What does this mean?</span></div><div class="card span3"><div class="muted">Market</div><div class="metric" id="marketState">Checking…</div><span class="muted" id="marketDetail">Connect live data for status</span></div><div class="card span3"><div class="muted">Risk level</div><div class="metric" id="riskHome">Balanced</div><button class="help" onclick="goByName('settings')">Change preset</button></div>
   <div class="card span8"><div class="row space"><div><b>Your watchlist</b><div class="muted">Plain-English research summary</div></div><button class="btn secondary" onclick="refreshAll()">Refresh data</button></div><div id="homeStocks"></div></div>
   <div class="card span4"><b>Getting started</b><p class="muted">Three safe steps for a new investor:</p><ol style="line-height:1.9;padding-left:20px"><li>Connect your Twelve Data key.</li><li>Explore a stock and read “Why?”</li><li>Practice with simulated money.</li></ol><button class="btn wide" onclick="goByName('settings')">Connect live data</button><p class="notice" style="margin-bottom:0">No brokerage connection. This app cannot place real trades.</p></div></div>
  </section>
  <section class="page" id="page-explore"><div class="eyebrow">DISCOVER & UNDERSTAND</div><h1 class="heading">Explore stocks</h1><p class="sub">Search a U.S. ticker to see an original Adaptive Score based on price trend, momentum, and risk.</p><div class="card"><div class="row"><input id="searchTicker" class="input" style="width:220px" value="AAPL" maxlength="8" placeholder="Ticker, e.g. AAPL"><button class="btn" onclick="research()">Research stock</button><button class="btn secondary" onclick="addFromSearch()">Add to watchlist</button></div><div id="researchResult" style="margin-top:20px"><div class="empty">Enter a ticker and choose Research stock.</div></div></div></section>
  <section class="page" id="page-stocks"><div class="eyebrow">WATCHLIST & HOLDINGS</div><h1 class="heading">My Stocks</h1><p class="sub">Keep the companies you want to follow in one place.</p><div class="grid"><div class="card span8"><div class="row space"><b>Watchlist</b><div><input id="addTicker" class="input" style="width:130px" placeholder="Ticker"><button class="btn" onclick="addTicker()">Add</button></div></div><div id="watchTable"></div></div><div class="card span4"><b>Paper holdings</b><div id="holdings"></div></div></div></section>
  <section class="page" id="page-paper"><div class="eyebrow">PRACTICE WITHOUT REAL MONEY</div><h1 class="heading">Guided paper trading</h1><p class="sub">Set up a simulated strategy one step at a time. You can stop it at any time.</p><div class="card"><div class="steps"><div class="step on" id="st1">1. Risk</div><div class="step" id="st2">2. Limits</div><div class="step" id="st3">3. Strategy</div><div class="step" id="st4">4. Review</div></div><div id="wizard"></div></div><div class="grid" style="margin-top:16px"><div class="card span7"><b>Paper trade history</b><div id="tradeHistory"></div></div><div class="card span5"><b>Safety status</b><p><span class="statusdot" id="autoDot"></span><span id="autoStatus">Automatic paper trading is OFF</span></p><p class="muted">Trades are simulated locally. Nothing is sent to Fidelity or any broker.</p><button class="btn danger" onclick="emergencyStop()">Emergency Stop</button></div><div class="card span12"><div class="row space"><div><b>Historical market simulation</b><div class="muted">Find every selected U.S. stock that would have met the paper-buy rule in a past 1-minute window. This never changes your paper portfolio.</div></div><button class="help" onclick="help('replay')">How does this work?</button></div><div class="sim-form"><div class="sim-field sim-universe"><label for="simUniverse">Market universe</label><select id="simUniverse" class="input" onchange="onSimulationUniverseChange()"><option value="liquid100">U.S. large-cap 100</option><option value="listing">All current U.S. common-stock listings</option><option value="watch">My watchlist</option><option value="custom">My ticker list</option></select></div><div class="sim-field"><label for="simLimit">Maximum to scan</label><select id="simLimit" class="input"><option value="50">50 stocks</option><option value="100" selected>100 stocks</option><option value="500">500 stocks</option><option value="0">All selected stocks</option></select></div><div class="sim-field"><label for="simRate">Data-plan pace</label><select id="simRate" class="input"><option value="6" selected>Free/Basic - 6 per minute</option><option value="20">Higher plan - 20 per minute</option><option value="60">Professional plan - 60 per minute</option></select></div><div class="sim-field sim-time"><label for="simStart">Start (Pacific time)</label><input id="simStart" class="input" value="2026-08-07 09:00"></div><div class="sim-field sim-time"><label for="simEnd">End (Pacific time)</label><input id="simEnd" class="input" value="2026-08-07 09:05"></div><div class="sim-actions"><button class="btn" onclick="runMarketSimulation()">Run market simulation</button><button class="btn secondary" onclick="stopMarketSimulation()">Stop scan</button></div></div><div id="simCustomWrap" class="sim-custom" style="display:none"><label for="simCustomSymbols">Tickers (separate with commas)</label><input id="simCustomSymbols" class="input wide" placeholder="Example: AAPL, MSFT, NVDA"></div><div id="simulationResult" class="why" style="display:none"></div></div></div></section>
  <section class="page" id="page-learn"><div class="eyebrow">LEARN AS YOU GO</div><h1 class="heading">Learn the basics</h1><p class="sub">Short explanations without the Wall Street vocabulary.</p><div class="grid"><div class="card span6"><div class="lesson"><b>Adaptive Score</b><p>A 1–10 research summary created by this app. Higher means recent technical conditions look more favorable; it does not guarantee a gain.</p><button class="help" onclick="help('score')">More detail</button></div><div class="lesson"><b>Trend</b><p>The general direction of price. A positive trend means recent prices are above their longer-term average.</p></div><div class="lesson"><b>Momentum</b><p>How strongly price has recently moved in one direction. Momentum can reverse quickly.</p></div></div><div class="card span6"><div class="lesson"><b>Risk & volatility</b><p>Volatility describes the size of price swings. Bigger swings mean more uncertainty and potentially larger losses.</p></div><div class="lesson"><b>RSI</b><p>The Relative Strength Index compares recent upward and downward moves. Very high or low readings can warn that a move is stretched.</p><button class="help" onclick="help('rsi')">What does this mean?</button></div><div class="lesson"><b>Drawdown</b><p>The decline from a recent high to a later low. It helps show how painful a losing period might have been.</p></div></div></div></section>
  <section class="page" id="page-settings"><div class="eyebrow">DATA, RISK & PREFERENCES</div><h1 class="heading">Settings</h1><p class="sub">Connect market data and choose how cautious your simulated trading should be.</p><div class="grid"><div class="card span6"><b>Twelve Data connection</b><p class="muted">Your API key stays on this Windows computer. It is sent only to Twelve Data when requesting market information.</p><label>API key</label><input id="apiKey" type="password" class="input wide" style="margin:7px 0 11px" placeholder="Paste your Twelve Data API key"><div class="row"><button class="btn" onclick="saveKeyAndConnect()">Save & Connect</button><button class="btn secondary" onclick="openSignup()">Create free account</button><button class="btn secondary" onclick="forgetKey()">Forget key</button></div><p id="connectionMsg" class="muted"></p></div><div class="card span6"><b>Risk preset</b><p class="muted">This changes simulated position and loss limits.</p><div id="presetSettings"></div><div class="advanced-only" style="margin-top:15px"><label>Custom maximum per trade ($)</label><input id="customTrade" class="input wide" type="number"><label>Custom daily loss ($)</label><input id="customLoss" class="input wide" type="number"><button class="btn secondary" style="margin-top:10px" onclick="saveCustomRisk()">Save detailed limits</button></div></div><div class="card span12"><b>App preferences</b><p><label><input type="checkbox" id="advCheck" onchange="setAdvanced(this.checked)"> Show Advanced Mode</label></p><p class="muted">Advanced Mode reveals raw indicators, rankings, score evolution, alpha factors, and detailed risk controls.</p><button class="btn secondary" onclick="resetApp()">Reset local app data</button></div></div></section>
  <section class="page" id="page-advanced"><div class="eyebrow">ADVANCED MODE</div><h1 class="heading">Research Lab</h1><p class="sub">Detailed model inputs for transparency. Adaptive Score is this app's original technical model—not Danelfin's proprietary score.</p><div class="grid"><div class="card span7"><b>Adaptive rankings</b><div id="rankings"></div></div><div class="card span5"><b>Score evolution</b><div id="evolution"></div></div><div class="card span7"><b>Explainable alpha factors</b><div id="factors"></div></div><div class="card span5"><b>Detailed risk controls</b><div id="riskDetails"></div></div></div></section>
  <div class="footer">Adaptive Trader V3.0.4 • Educational research and paper trading only • Not investment advice</div>
 </main>
</div>
<div class="modalbg" id="modalBg"><div class="modal"><div class="row space"><h2 id="modalTitle">Help</h2><button class="btn secondary small" onclick="closeModal()">Close</button></div><div id="modalBody"></div></div></div>
<script language="javascript">
var APP_VERSION='3.0.4', REG='HKCU\\Software\\AdaptiveTraderV25\\';
var defaults={watch:['AAPL','MSFT','NVDA','SPY'],risk:'Balanced',maxTrade:1000,maxLoss:250,advanced:false,cash:100000,holdings:{},trades:[],scores:{},history:{},auto:false,wizard:1,updateUrl:'',slippageBps:5,daily:{date:'',realized:0},marketOpen:false,lastRefresh:'',fontSize:16,simulationScores:{}};
var S=loadState(), quoteCache={}, refreshing=false, refreshTimer=0, apiKeyCache='', navIsOpen=false, marketScanId=0, marketScanRunning=false;
function clone(o){return JSON.parse(JSON.stringify(o))}
function regRead(n){try{return new ActiveXObject('WScript.Shell').RegRead(REG+n)}catch(e){return ''}}
function regWrite(n,v){try{new ActiveXObject('WScript.Shell').RegWrite(REG+n,String(v),'REG_SZ')}catch(e){}}
function loadState(){var x=clone(defaults),raw='';try{raw=regRead('State')||localStorage.getItem('adaptiveTraderV25')||'';if(raw){var p=JSON.parse(raw);for(var k in p)x[k]=p[k]}}catch(e){}return x}
function save(){var raw=JSON.stringify(S);regWrite('State',raw);try{localStorage.setItem('adaptiveTraderV25',raw)}catch(e){}}
function keyHelper(mode,value){try{var helper=appFolder()+'\\Secure Key Helper.ps1',fso=new ActiveXObject('Scripting.FileSystemObject');if(!fso.FileExists(helper))return '';var e=new ActiveXObject('WScript.Shell').Exec('powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "'+helper+'" '+mode);if(mode=='set'){e.StdIn.Write(value);e.StdIn.Close()}return String(e.StdOut.ReadAll()||'').replace(/^\s+|\s+$/g,'')}catch(e){return ''}}
function key(){if(apiKeyCache)return apiKeyCache;var v=keyHelper('get','');if(v){apiKeyCache=v;return v}v=regRead('ApiKey');if(v){setKey(v);return v}try{v=localStorage.getItem('adaptiveTraderKey')||'';if(v)setKey(v);return v}catch(e){return ''}}
function setKey(v){apiKeyCache=v||'';var result=keyHelper(v?'set':'clear',v||'');if(result!='OK')regWrite('ApiKey',v||'');try{localStorage.removeItem('adaptiveTraderKey')}catch(e){}}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function money(n){return '$'+Number(n||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}
function go(name,el){navIsOpen=false;var ps=document.getElementsByClassName('page');for(var i=0;i<ps.length;i++)ps[i].className='page';document.getElementById('page-'+name).className='page active';var ns=document.getElementsByClassName('nav');for(i=0;i<ns.length;i++)ns[i].className='nav';if(el)el.className='nav active';applyMode();renderAll();if(name=='paper')renderSimulationControls()}
function goByName(n){var ns=document.getElementsByClassName('nav');for(var i=0;i<ns.length;i++)if(ns[i].getAttribute('data-page')==n){go(n,ns[i]);return}}
function toggleAdvanced(){setAdvanced(!S.advanced)}
function setAdvanced(v){S.advanced=!!v;save();applyMode()}
function applyMode(){document.getElementById('shell').className='shell'+(S.advanced?' advanced':'')+(navIsOpen?' nav-open':'');document.getElementById('modeBtn').innerHTML=S.advanced?'Advanced Mode':'Beginner Mode';document.getElementById('advCheck').checked=S.advanced;document.getElementById('navBtn').innerHTML=navIsOpen?'Close Menu':'Menu'}
function toggleNav(){navIsOpen=!navIsOpen;applyMode()}
function fontPt(){var p=Number(S.fontSize||16);return p==14||p==16||p==18||p==20?p:16}
function applyFontSize(){var p=fontPt(),side=220+(p-14)*10,top=104+(p-14)*8,breakpoint=p>=20?1550:p>=18?1400:1250,css='body,button,input,select,textarea,.nav,.badge,.btn,.btn.small,.pill,th,td,.footer,.eyebrow,.help,.brand small{font-size:'+p+'pt!important}.brand{font-size:'+(p+6)+'pt!important}.heading,.metric{font-size:'+(p+8)+'pt!important}.score{width:'+(78+p*2)+'px;height:'+(78+p*2)+'px;font-size:'+(p+10)+'pt!important}.top{min-height:'+top+'px}.side{top:'+top+'px;width:'+side+'px}.main{padding-top:'+(top+52)+'px}.page,.page.active{padding-top:42px}body{padding-left:'+side+'px}@media(max-width:'+breakpoint+'px){body{padding-left:0!important}.main{margin-left:0!important;padding-left:38px!important;padding-right:38px!important}.side{display:none}.menu-toggle{display:inline-block}.shell.nav-open .side{display:block;position:fixed;top:'+(top+38)+'px;bottom:0;left:0;width:370px;max-width:88%;z-index:40;overflow-y:auto;box-shadow:8px 0 25px rgba(10,25,45,.28)}.span3,.span4,.span5,.span6,.span7,.span8{width:calc(100% - 22px)}}@media(max-width:700px){.top{min-height:'+(top+120)+'px}.topright{width:100%;margin-left:0}.main{padding-top:'+(top+164)+'px!important;padding-left:24px!important;padding-right:24px!important}.shell.nav-open .side{top:'+(top+120)+'px;width:100%;max-width:100%}.card{padding:20px}.page,.page.active{padding-top:30px}}',style=document.getElementById('userFontStyle');if(!style){style=document.createElement('style');style.id='userFontStyle';document.getElementsByTagName('head')[0].appendChild(style)}if(style.styleSheet)style.styleSheet.cssText=css;else style.innerHTML=css}
function renderFontControl(){var page=document.getElementById('page-settings'),card=document.getElementById('fontControlCard');if(!page)return;if(!card){card=document.createElement('div');card.id='fontControlCard';card.className='card';card.style.marginTop='18px';card.innerHTML='<b>Text size and layout</b><p class="muted">Choose the reading size that feels comfortable. The layout automatically gives content more room at larger sizes.</p><div class="row"><label>Text size <select id="fontSizeSelect" class="input"><option value="14">14 pt — compact</option><option value="16">16 pt — standard</option><option value="18">18 pt — large</option><option value="20">20 pt — extra large</option></select></label><button class="btn" onclick="saveFontSize()">Apply text size</button></div>';page.appendChild(card)}document.getElementById('fontSizeSelect').value=''+fontPt()}
function saveFontSize(){S.fontSize=Number(document.getElementById('fontSizeSelect').value);save();applyFontSize();renderFontControl();renderAll()}
function applyComfortNav(){var p=fontPt(),side=p>=20?410:p>=18?350:p>=16?290:240,overlay=p>=20?520:p>=18?460:p>=16?400:360,breakpoint=p>=20?2000:p>=18?1750:p>=16?1500:1300,top=104+(p-14)*8,css='body{padding-left:'+side+'px!important}.side{width:'+side+'px!important}.shell.nav-open .side{width:'+overlay+'px!important;max-width:92%!important}@media(max-width:'+breakpoint+'px){body{padding-left:0!important}.side{display:none!important}.menu-toggle{display:inline-block!important}.shell.nav-open .side{display:block!important;position:fixed!important;top:'+(top+30)+'px!important;bottom:0!important;left:0!important;width:'+overlay+'px!important;max-width:92%!important;z-index:40!important;overflow-y:auto!important;box-shadow:8px 0 25px rgba(10,25,45,.28)!important}}@media(max-width:700px){.shell.nav-open .side{top:'+(top+120)+'px!important;width:100%!important;max-width:100%!important}}',style=document.getElementById('comfortNavStyle');if(!style){style=document.createElement('style');style.id='comfortNavStyle';document.getElementsByTagName('head')[0].appendChild(style)}if(style.styleSheet)style.styleSheet.cssText=css;else style.innerHTML=css}
function applyMode(){document.getElementById('shell').className='shell'+(S.advanced?' advanced':'')+(navIsOpen?' nav-open':'');document.getElementById('modeBtn').innerHTML=S.advanced?'Advanced Mode':'Beginner Mode';document.getElementById('advCheck').checked=S.advanced;document.getElementById('navBtn').innerHTML=navIsOpen?'Close Menu':'Menu';var search=document.getElementById('searchTicker');if(search){search.maxLength=60;search.placeholder='Ticker or company, e.g. TSMC'}applyComfortNav()}
function saveFontSize(){S.fontSize=Number(document.getElementById('fontSizeSelect').value);save();applyFontSize();applyComfortNav();renderFontControl();renderAll()}
function rating(s){return s>=8.5?'Strong':s>=7?'Positive':s>=4.5?'Neutral':s>=3?'Cautious':'Weak'}
function signalClass(s){return s>=7?'good':s<4.5?'warn':''}
function demo(t){var base={AAPL:212.34,MSFT:448.12,NVDA:184.55,SPY:632.90,AMZN:221.40,GOOGL:201.18,TSLA:327.65}[t]||100;var seed=0;for(var i=0;i<t.length;i++)seed+=t.charCodeAt(i);var vals=[];for(i=80;i>=0;i--){var trend=(80-i)*((seed%9)-3)/500;var wave=Math.sin((i+seed)/5)*.018;vals.push({close:base*(1+trend+wave),volume:1000000+(i%7)*120000})}return vals}
function calc(vals){if(!vals||vals.length<30)return null;var c=[],i;for(i=0;i<vals.length;i++)c.push(Number(vals[i].close));function avg(a,b){var z=0;for(var j=a;j<b;j++)z+=c[j];return z/(b-a)}var last=c[0],s20=avg(0,20),s50=avg(0,50),mom=(last/c[10]-1)*100;var gains=0,loss=0;for(i=0;i<14;i++){var d=c[i]-c[i+1];if(d>0)gains+=d;else loss-=d}var rsi=loss===0?70:100-(100/(1+(gains/loss)));var rets=[],down=[];for(i=0;i<30;i++){var r=c[i]/c[i+1]-1;rets.push(r);if(r<0)down.push(r)}function sd(a){if(!a.length)return 0;var m=0,j;for(j=0;j<a.length;j++)m+=a[j];m/=a.length;var q=0;for(j=0;j<a.length;j++)q+=(a[j]-m)*(a[j]-m);return Math.sqrt(q/a.length)}var vol=sd(rets)*Math.sqrt(252)*100,downVol=sd(down)*Math.sqrt(252)*100,max=c[0],dd=0;for(i=0;i<c.length;i++){if(c[i]>max)max=c[i];var x=(c[i]/max-1)*100;if(x<dd)dd=x}var trend=5+(last>s20?1.5:-1.5)+(s20>s50?1.5:-1.5);var momentum=5+Math.max(-3,Math.min(3,mom/2));var rsiScore=rsi>75?3:rsi>55?7.5:rsi>=42?6:rsi>=28?4.5:3.5;var technical=Math.max(1,Math.min(10,trend*.45+momentum*.35+rsiScore*.20));var lowrisk=Math.max(1,Math.min(10,10-vol/8+dd/12));var score=Math.round((technical*.72+lowrisk*.28)*10)/10;return{price:last,sma20:s20,sma50:s50,momentum:mom,rsi:rsi,vol:vol,downVol:downVol,drawdown:dd,technical:technical,lowrisk:lowrisk,score:score,trend:last>s20?'Positive':'Negative'}}
function api(path,cb,useQuery,retry){var x=new XMLHttpRequest(),done=false,url='https://api.twelvedata.com'+path;if(useQuery)url+=(path.indexOf('?')>=0?'&':'?')+'apikey='+encodeURIComponent(key());function finish(err,data){if(done)return;done=true;cb(err,data)}x.onreadystatechange=function(){if(x.readyState!=4)return;if(x.status>=200&&x.status<300){try{finish(null,JSON.parse(x.responseText))}catch(e){finish('Invalid data response')}}else if(!useQuery&&(x.status==0||x.status==401||x.status==403)){api(path,cb,true,retry)}else if(!retry&&(x.status==0||x.status==429||x.status>=500)){setTimeout(function(){api(path,cb,useQuery,true)},1200)}else finish('Market-data request failed ('+x.status+').')};try{x.open('GET',url,true);x.timeout=15000;if(!useQuery)x.setRequestHeader('Authorization','apikey '+key());x.ontimeout=function(){if(!retry)setTimeout(function(){api(path,cb,useQuery,true)},1200);else finish('Market-data request timed out.')};x.send()}catch(e){if(!useQuery)api(path,cb,true,retry);else finish('Could not request market data.')}}
function dayKey(){var d=new Date();return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate()}
function dailyState(){var k=dayKey();if(!S.daily||S.daily.date!=k){S.daily={date:k,realized:0};save()}return S.daily}
function getQuote(t,d,cb){api('/quote?symbol='+encodeURIComponent(t),function(err,j){if(err||!j||j.status=='error'){cb((j&&j.message)||err||'No quote data');return}var p=Number(j.close||j.price||j.last);if(!isFinite(p)||p<=0){cb('Quote did not include a valid price.');return}d.price=p;d.asOf=j.datetime||new Date().toLocaleString();d.marketOpen=j.is_market_open===true||String(j.is_market_open).toLowerCase()=='true';d.live=true;S.marketOpen=d.marketOpen;document.getElementById('marketState').innerHTML=d.marketOpen?'<span class="green">OPEN</span>':'CLOSED';document.getElementById('marketDetail').innerHTML=d.marketOpen?'Latest quote received':'Showing the latest available quote';cb(null,d)})}
function saveScore(t,d){S.scores[t]=d.score;if(!S.history[t])S.history[t]=[];var h=S.history[t],last=h.length?h[h.length-1]:null;if(!last||last.s!=d.score){h.push({d:new Date().toLocaleDateString(),s:d.score});if(h.length>20)h.shift()}save()}
function getStock(t,cb){t=t.toUpperCase();if(!key()){var demoData=calc(demo(t));demoData.asOf='Demonstration data';demoData.marketOpen=false;quoteCache[t]=demoData;cb(null,demoData);return}var cached=quoteCache[t],age=cached&&cached.historyAt?(new Date().getTime()-cached.historyAt):999999999;function withQuote(d){getQuote(t,d,function(err,q){if(!err){quoteCache[t]=q;saveScore(t,q)}cb(err,q||d)})}if(cached&&age<21600000){withQuote(cached);return}api('/time_series?symbol='+encodeURIComponent(t)+'&interval=1day&outputsize=80',function(err,j){if(err||!j||j.status=='error'||!j.values){cb((j&&j.message)||err||'No daily history');return}var rows=j.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});var d=calc(rows);if(!d){cb('Not enough valid daily data.');return}d.historyAt=new Date().getTime();withQuote(d)})}
function scheduleRefresh(){if(refreshTimer)clearTimeout(refreshTimer);if(!key())return;refreshTimer=setTimeout(function(){refreshAll()},S.marketOpen?300000:1800000)}
function refreshAll(){if(refreshing)return;refreshing=true;setConnection('Refreshing…',false);var list=S.watch.slice(0),i=0,errors=[];function next(){if(i>=list.length){refreshing=false;S.lastRefresh=new Date().toLocaleString();save();runAutoPaper();if(errors.length){setConnection('Data issue',false);document.getElementById('marketDetail').innerHTML='Last refresh '+S.lastRefresh+' • '+errors[0]}else{setConnection(key()?'Live data':'Demo data',!!key());document.getElementById('marketDetail').innerHTML+=(S.lastRefresh?' • Refreshed '+S.lastRefresh:'')}renderAll();scheduleRefresh();return}getStock(list[i++],function(err){if(err)errors.push(err);next()})}next()}
function renderSimulationControls(){var e=document.getElementById('simTicker');if(!e)return;var prior=e.value,h='';for(var i=0;i<S.watch.length;i++)h+='<option value="'+esc(S.watch[i])+'">'+esc(S.watch[i])+'</option>';e.innerHTML=h;if(prior&&S.watch.indexOf(prior)>=0)e.value=prior}
function showSimulation(text,isError){var e=document.getElementById('simulationResult');if(!e)return;e.style.display='block';e.className=isError?'notice':'why';e.innerHTML=text}
function validSimulationTime(v){return /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}$/.test(v)}
function runHistoricalSimulation(){if(!key()){showSimulation('Connect your Twelve Data API key in Settings before running a historical simulation.',true);return}renderSimulationControls();var t=document.getElementById('simTicker').value,start=document.getElementById('simStart').value.replace(/^\s+|\s+$/g,''),end=document.getElementById('simEnd').value.replace(/^\s+|\s+$/g,'');if(!t||!validSimulationTime(start)||!validSimulationTime(end)||end<=start){showSimulation('Enter a valid start and end such as 2026-08-07 09:00 and 2026-08-07 09:05.',true);return}showSimulation('Loading daily context and 1-minute historical prices for '+esc(t)+'…',false);var priorEnd=start.substr(0,10)+' 00:00:00',zone='America/Los_Angeles';api('/time_series?symbol='+encodeURIComponent(t)+'&interval=1day&end_date='+encodeURIComponent(priorEnd)+'&outputsize=80&timezone='+encodeURIComponent(zone),function(err,daily){if(err||!daily||daily.status=='error'||!daily.values){showSimulation(esc((daily&&daily.message)||err||'Could not load daily context.'),true);return}var dailyRows=daily.values.slice(0);dailyRows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});var scoreData=calc(dailyRows);if(!scoreData){showSimulation('There was not enough daily history to calculate the strategy score.',true);return}api('/time_series?symbol='+encodeURIComponent(t)+'&interval=1min&start_date='+encodeURIComponent(start)+'&end_date='+encodeURIComponent(end)+'&outputsize=20&timezone='+encodeURIComponent(zone),function(err,bars){if(err||!bars||bars.status=='error'||!bars.values){showSimulation(esc((bars&&bars.message)||err||'Could not load 1-minute prices.'),true);return}var rows=bars.values.slice(0);rows.sort(function(a,b){return String(a.datetime)<String(b.datetime)?-1:String(a.datetime)>String(b.datetime)?1:0});var usable=[];for(var i=0;i<rows.length;i++)if(String(rows[i].datetime)>=start&&String(rows[i].datetime)<end&&isFinite(Number(rows[i].close)))usable.push(rows[i]);if(!usable.length){showSimulation('No 1-minute prices were returned for that Pacific-time window. The market may have been closed or the plan may not include this interval.',true);return}var cash=100000,shares=0,action='No simulated trade',first=Number(usable[0].close),last=Number(usable[usable.length-1].close),fill=first*(1+slippage());if(scoreData.score>=8.5){shares=Math.floor(S.maxTrade/fill);if(shares>0){cash-=shares*fill;action='BUY '+shares+' simulated shares at '+money(fill)+' (score '+scoreData.score.toFixed(1)+')'}}else if(scoreData.score<=3)action='No position to sell (score '+scoreData.score.toFixed(1)+')';else action='No trade: score '+scoreData.score.toFixed(1)+' is between the automatic thresholds';var endValue=cash+shares*last,pnl=endValue-100000;showSimulation('<b>Simulation complete — '+esc(t)+'</b><br>Window: '+esc(start)+' to '+esc(end)+' Pacific time • '+usable.length+' one-minute bars<br>Score calculated from daily data available before the window: <b>'+scoreData.score.toFixed(1)+'/10</b><br>Action: <b>'+action+'</b><br>Start price: '+money(first)+' • End price: '+money(last)+'<br>Simulated ending value: <b>'+money(endValue)+'</b> • P/L: <b class="'+(pnl>=0?'green':'red')+'">'+money(pnl)+'</b><br><span class="muted">Uses the current '+S.risk+' per-trade limit of '+money(S.maxTrade)+' and '+Number(S.slippageBps||5)+' basis points of simulated slippage. This replay does not change your paper portfolio.</span>',false)})})}
/* Broad historical market scanner. It intentionally uses daily data published before the replay window. */
var US_LARGE_CAP_100=('AAPL,MSFT,NVDA,AMZN,GOOGL,GOOG,META,AVGO,TSLA,BRK.B,LLY,JPM,V,UNH,XOM,MA,JNJ,WMT,PG,ORCL,COST,HD,ABBV,BAC,KO,CRM,NFLX,MRK,CVX,AMD,PEP,TMO,ADBE,LIN,MCD,CSCO,ACN,ABT,DHR,WFC,DIS,PM,INTU,GE,CAT,IBM,AMGN,TXN,UBER,QCOM,VZ,INTC,NEE,RTX,ISRG,LOW,GS,SPGI,BLK,SYK,PLD,AXP,MDT,DE,ADI,GILD,ADP,REGN,VRTX,MMC,CB,MO,ETN,SO,PANW,KLAC,CRWD,CMCSA,DUK,SHW,WM,APD,BDX,CI,EQIX,EMR,FDX,ICE,ITW,FCX,PSA,ROP,MSI,GM,ORLY,PHM,EW,NSC,HCA,MCO').split(',');
function normSymbol(v){v=String(v||'').replace(/^\s+|\s+$/g,'').toUpperCase();return /^[A-Z]{1,5}(\.[A-Z])?$/.test(v)?v:''}
function uniqueSymbols(a){var out=[],seen={},i,t;for(i=0;i<a.length;i++){t=normSymbol(a[i]);if(t&&!seen[t]){seen[t]=true;out.push(t)}}return out}
function simulationMinutes(a,b){var r=/^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})$/,x=a.match(r),y=b.match(r);if(!x||!y)return 0;var dx=Date.UTC(Number(x[1]),Number(x[2])-1,Number(x[3]),Number(x[4]),Number(x[5])),dy=Date.UTC(Number(y[1]),Number(y[2])-1,Number(y[3]),Number(y[4]),Number(y[5]));return Math.round((dy-dx)/60000)}
function onSimulationUniverseChange(){var u=document.getElementById('simUniverse'),w=document.getElementById('simCustomWrap');if(u&&w)w.style.display=u.value=='custom'?'block':'none'}
function renderSimulationControls(){onSimulationUniverseChange()}
function prioritizedListing(a){var present={},used={},out=[],i,t;for(i=0;i<a.length;i++)present[a[i]]=true;for(i=0;i<US_LARGE_CAP_100.length;i++){t=US_LARGE_CAP_100[i];if(present[t]&&!used[t]){used[t]=true;out.push(t)}}a.sort();for(i=0;i<a.length;i++)if(!used[a[i]]){used[a[i]]=true;out.push(a[i])}return out}
function loadCurrentUsListing(cb){api('/stocks?country=United%20States&type=Common%20Stock',function(err,j){if(err||!j||j.status=='error'){cb((j&&j.message)||err||'Could not load the current U.S. stock listing.');return}var raw=j.data||j.values||j,all=[],i,item,t,country,type;if(typeof raw.length=='undefined'){cb('The stock-list response did not include a usable list.');return}for(i=0;i<raw.length;i++){item=raw[i]||{};country=String(item.country||'').toLowerCase();type=String(item.type||'').toLowerCase();if(country&&country!='united states'&&country!='usa'&&country!='us')continue;if(type&&type.indexOf('common')<0&&type!='stock')continue;t=normSymbol(item.symbol||item.ticker||item.code);if(t)all.push(t)}all=prioritizedListing(uniqueSymbols(all));if(!all.length){cb('No U.S. common-stock symbols were returned.');return}cb(null,all)})}
function getSimulationUniverse(cb){var u=document.getElementById('simUniverse'),type=u?u.value:'liquid100';if(type=='watch'){cb(null,uniqueSymbols(S.watch),'your watchlist');return}if(type=='custom'){var c=document.getElementById('simCustomSymbols'),list=uniqueSymbols(String(c?c.value:'').split(','));if(!list.length){cb('Enter at least one valid ticker, separated with commas.');return}cb(null,list,'your ticker list');return}if(type=='listing'){loadCurrentUsListing(function(err,list){cb(err,list,'all current U.S. common-stock listings')});return}cb(null,US_LARGE_CAP_100.slice(0),'the built-in U.S. large-cap 100')}
function batchEntry(j,t){if(!j)return null;if(j.values)return j;if(String(j.symbol||'').toUpperCase()==t.toUpperCase())return j;if(j.meta&&String(j.meta.symbol||'').toUpperCase()==t.toUpperCase())return j;if(j[t])return j[t];for(var k in j)if(String(k).toUpperCase()==t.toUpperCase())return j[k];return null}
function batchSymbols(a){var x=[],i;for(i=0;i<a.length;i++)x.push(encodeURIComponent(a[i]));return x.join(',')}
/* Faster live-data path: batch up to four symbols so the standard watchlist stays within an 8-credit/minute basic plan. */
var LIVE_BATCH_SIZE=4;
function fastHistoryBatch(batch,cb){api('/time_series?symbol='+batchSymbols(batch)+'&interval=1day&outputsize=80',function(err,j){var errors=[],i,t,z,rows,d;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Daily market-data request failed.')}else for(i=0;i<batch.length;i++){t=batch[i];z=batchEntry(j,t);if(!z||z.status=='error'||!z.values){errors.push(t+': no daily history');continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});d=calc(rows);if(!d){errors.push(t+': not enough daily history');continue}d.historyAt=new Date().getTime();quoteCache[t]=d}cb(errors)})}
function fastQuoteBatch(batch,cb){api('/quote?symbol='+batchSymbols(batch),function(err,j){var errors=[],i,t,q,d,p,open,known=false,anyOpen=false;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Quote request failed.')}else for(i=0;i<batch.length;i++){t=batch[i];q=batchEntry(j,t);d=quoteCache[t];if(!q||q.status=='error'||!d){errors.push(t+': no quote');continue}p=Number(q.close||q.price||q.last);if(!isFinite(p)||p<=0){errors.push(t+': invalid quote');continue}if(typeof q.is_market_open!='undefined'){known=true;open=q.is_market_open===true||String(q.is_market_open).toLowerCase()=='true';if(open)anyOpen=true;d.marketOpen=open}d.price=p;d.asOf=q.datetime||new Date().toLocaleString();d.live=true;quoteCache[t]=d}if(known)S.marketOpen=anyOpen;document.getElementById('marketState').innerHTML=S.marketOpen?'<span class="green">OPEN</span>':'CLOSED';document.getElementById('marketDetail').innerHTML=S.marketOpen?'Latest live quotes received':'Showing the latest available quotes';cb(errors)})}
function scheduleRefresh(){if(refreshTimer)clearTimeout(refreshTimer);if(!key())return;refreshTimer=setTimeout(function(){refreshAll()},S.marketOpen?60000:1800000)}
function refreshAll(){if(refreshing)return;refreshing=true;setConnection('Refreshing live data...',false);var list=S.watch.slice(0),need=[],errors=[],i,cached,age,hi=0,qi=0;function finish(){refreshing=false;S.lastRefresh=new Date().toLocaleString();save();if(errors.length){setConnection('Data issue',false);document.getElementById('marketDetail').innerHTML='Last refresh '+S.lastRefresh+' - '+errors[0]}else{setConnection(key()?'Live data':'Demo data',!!key());document.getElementById('marketDetail').innerHTML+=(S.lastRefresh?' - Refreshed '+S.lastRefresh:'')}renderAll();scheduleRefresh()}if(!key()){for(i=0;i<list.length;i++){cached=calc(demo(list[i]));cached.asOf='Demonstration data';cached.marketOpen=false;quoteCache[list[i]]=cached}finish();return}for(i=0;i<list.length;i++){cached=quoteCache[list[i]];age=cached&&cached.historyAt?(new Date().getTime()-cached.historyAt):999999999;if(!cached||age>=21600000)need.push(list[i])}function quotes(){if(qi>=list.length){finish();return}var batch=list.slice(qi,Math.min(qi+LIVE_BATCH_SIZE,list.length));qi+=batch.length;fastQuoteBatch(batch,function(es){for(var n=0;n<es.length;n++)errors.push(es[n]);runAutoPaperFor(batch);if(qi<list.length)setTimeout(quotes,61000);else finish()})}function histories(){if(hi>=need.length){quotes();return}var batch=need.slice(hi,Math.min(hi+LIVE_BATCH_SIZE,need.length));hi+=batch.length;fastHistoryBatch(batch,function(es){for(var n=0;n<es.length;n++)errors.push(es[n]);if(hi<need.length)setTimeout(histories,61000);else histories()})}histories()}
function simulationEstimate(n,rate){var m=Math.max(1,Math.ceil(n/rate));return m<=1?'about one minute':('about '+m+' minutes for the daily screening, plus time for any buy candidates')}
function showScanProgress(text){showSimulation('<b>Market scan in progress</b><br>'+text+'<br><span class="muted">Keep Adaptive Trader open. The scan is paced to respect the selected Twelve Data plan. You can use Stop scan at any time.</span>',false)}
function stopMarketSimulation(){if(!marketScanRunning){showSimulation('There is no market scan running.',false);return}marketScanId++;marketScanRunning=false;showSimulation('<b>Market scan stopped.</b><br>The paper portfolio was not changed. You can start another scan whenever you are ready.',false)}
function finishMarketScan(id){if(id==marketScanId)marketScanRunning=false}
function runMarketSimulation(){if(marketScanRunning){alert('A market scan is already running. Choose Stop scan before starting a new one.');return}if(!key()){showSimulation('Connect your Twelve Data API key in Settings before running a historical market simulation.',true);return}var start=document.getElementById('simStart').value.replace(/^\s+|\s+$/g,''),end=document.getElementById('simEnd').value.replace(/^\s+|\s+$/g,''),mins=simulationMinutes(start,end),limit=Number(document.getElementById('simLimit').value),rate=Number(document.getElementById('simRate').value);if(!validSimulationTime(start)||!validSimulationTime(end)||mins<1||mins>390){showSimulation('Choose a valid Pacific-time window from 1 minute up to one regular trading day (390 minutes).',true);return}marketScanRunning=true;apiCreditCap=Math.max(8,rate);if(refreshTimer){clearTimeout(refreshTimer);refreshTimer=0}var id=++marketScanId;showScanProgress('Preparing the selected market universe...');getSimulationUniverse(function(err,list,name){if(id!=marketScanId)return;if(err){finishMarketScan(id);showSimulation(esc(err),true);return}if(limit>0&&list.length>limit)list=list.slice(0,limit);if(!list.length){finishMarketScan(id);showSimulation('The selected market universe is empty.',true);return}if(list.length>100&&!confirm('This will screen '+list.length+' stocks. At the selected pace it takes '+simulationEstimate(list.length,rate)+' and consumes at least one data credit per stock, before 1-minute replays. Continue?')){finishMarketScan(id);showSimulation('Market scan cancelled before any data was requested.',false);return}screenMarketDaily(id,list,name,start,end,rate,mins)})}
function screenMarketDaily(id,list,name,start,end,rate,mins){var i=0,processed=0,buy=[],sell=[],noHistory=0,errors=[],priorEnd=start.substr(0,10)+' 00:00:00',zone='America/Los_Angeles';function next(){if(id!=marketScanId)return;if(i>=list.length){if(!buy.length){finishMarketScan(id);renderMarketResult({name:name,total:list.length,start:start,end:end,buy:buy,sell:sell,trades:[],noHistory:noHistory,noBars:0,errors:errors,minutes:mins});return}showScanProgress('Daily screening complete: '+processed+' of '+list.length+' stocks checked. '+buy.length+' buy signal(s) need a 1-minute replay next.');setTimeout(function(){replayBuyCandidates(id,list.length,name,start,end,rate,mins,buy,sell,noHistory,errors)},61000);return}var batch=list.slice(i,Math.min(i+rate,list.length));i+=batch.length;showScanProgress('Screening '+processed+' of '+list.length+' stocks. Checking the next '+batch.length+' daily histories...');api('/time_series?symbol='+batchSymbols(batch)+'&interval=1day&end_date='+encodeURIComponent(priorEnd)+'&outputsize=80&timezone='+encodeURIComponent(zone),function(err,j){var z,k,rows,d;processed+=batch.length;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Daily market-data request failed.')}else for(k=0;k<batch.length;k++){z=batchEntry(j,batch[k]);if(!z||z.status=='error'||!z.values){noHistory++;continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});d=calc(rows);if(!d){noHistory++;continue}if(d.score>=8.5)buy.push({t:batch[k],score:d.score});else if(d.score<=3)sell.push({t:batch[k],score:d.score})}showScanProgress('Daily screening: '+processed+' of '+list.length+' stocks checked. Buy signals found: '+buy.length+'.');if(i<list.length)setTimeout(next,61000);else next()})}next()}
function replayBuyCandidates(id,total,name,start,end,rate,mins,buy,sell,noHistory,errors){var i=0,processed=0,trades=[],noBars=0,zone='America/Los_Angeles',outsize=Math.max(20,Math.min(5000,mins+10));function next(){if(id!=marketScanId)return;if(i>=buy.length){finishMarketScan(id);renderMarketResult({name:name,total:total,start:start,end:end,buy:buy,sell:sell,trades:trades,noHistory:noHistory,noBars:noBars,errors:errors,minutes:mins});return}var batch=buy.slice(i,Math.min(i+rate,buy.length)),symbols=[],k;for(k=0;k<batch.length;k++)symbols.push(batch[k].t);i+=batch.length;showScanProgress('Replaying 1-minute prices for '+processed+' of '+buy.length+' buy candidate(s)...');api('/time_series?symbol='+batchSymbols(symbols)+'&interval=1min&start_date='+encodeURIComponent(start)+'&end_date='+encodeURIComponent(end)+'&outputsize='+outsize+'&timezone='+encodeURIComponent(zone),function(err,j){var z,rows,usable,q,first,last,fill,k,cand;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'One-minute market-data request failed.')}else for(k=0;k<batch.length;k++){cand=batch[k];z=batchEntry(j,cand.t);if(!z||z.status=='error'||!z.values){noBars++;continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)<String(b.datetime)?-1:String(a.datetime)>String(b.datetime)?1:0});usable=[];for(q=0;q<rows.length;q++)if(String(rows[q].datetime)>=start&&String(rows[q].datetime)<end&&isFinite(Number(rows[q].close)))usable.push(rows[q]);if(!usable.length){noBars++;continue}first=Number(usable[0].close);last=Number(usable[usable.length-1].close);fill=first*(1+slippage());q=Math.floor(S.maxTrade/fill);if(q>0)trades.push({t:cand.t,score:cand.score,shares:q,entry:fill,exit:last,pnl:(last-fill)*q,bars:usable.length})}processed+=batch.length;showScanProgress('1-minute replay: '+processed+' of '+buy.length+' buy candidate(s) checked.');if(i<buy.length)setTimeout(next,61000);else next()})}next()}
function renderMarketResult(x){var cash=100000,executed=[],i,t,cost,endValue,pnl=0,rows='';x.trades.sort(function(a,b){if(b.score!=a.score)return b.score-a.score;if(String(a.t)<String(b.t))return -1;if(String(a.t)>String(b.t))return 1;return 0});for(i=0;i<x.trades.length;i++){t=x.trades[i];cost=t.shares*t.entry;if(cost<=cash){cash-=cost;executed.push(t);pnl+=t.pnl}}endValue=cash;for(i=0;i<executed.length;i++)endValue+=executed[i].shares*executed[i].exit;for(i=0;i<executed.length;i++){t=executed[i];rows+='<tr><td><b>'+esc(t.t)+'</b></td><td>'+t.score.toFixed(1)+'</td><td>'+t.shares+'</td><td>'+money(t.entry)+'</td><td>'+money(t.exit)+'</td><td class="'+(t.pnl>=0?'green':'red')+'">'+money(t.pnl)+'</td></tr>'}var table=executed.length?'<table style="margin-top:14px"><tr><th>Stock traded</th><th>Score</th><th>Shares</th><th>Entry</th><th>End price</th><th>P/L</th></tr>'+rows+'</table>':'<p><b>No buys were executed.</b> No stock had both a qualifying pre-window score and usable 1-minute prices in the chosen window.</p>',signalText=x.buy.length+' buy signal(s)';showSimulation('<b>Market simulation complete</b><br>Universe: '+esc(x.name)+' - '+x.total+' stock(s) screened<br>Window: '+esc(x.start)+' to '+esc(x.end)+' Pacific time - '+x.minutes+' minute(s)<br>Daily score snapshot used only prices available before the window: <b>'+signalText+'</b>. '+x.sell.length+' sell signal(s) were not executed because this replay starts with cash and no holdings.<br>Executed paper buys: <b>'+executed.length+'</b> - Simulated ending value: <b>'+money(endValue)+'</b> - P/L: <b class="'+(pnl>=0?'green':'red')+'">'+money(pnl)+'</b>'+table+'<p class="muted">Each shown buy uses the first available 1-minute close plus '+Number(S.slippageBps||5)+' basis points of simulated slippage, then marks to the last close in the window. '+(x.noHistory?x.noHistory+' symbol(s) lacked enough pre-window daily history. ':'')+(x.noBars?x.noBars+' buy candidate(s) lacked usable 1-minute bars. ':'')+(x.errors.length?x.errors.length+' data request(s) could not be completed. ':'')+'This is a current-listing market scan, not a survivorship-bias-free whole-market backtest: delisted and renamed stocks are not included.</p>',false)}
/* Reusing a pre-window daily score makes repeat simulations for the same date much faster. */
function cachedSimulationScore(t,start){var all=S.simulationScores||{},x=all[t+'|'+start.substr(0,10)];return x&&isFinite(Number(x.score))?Number(x.score):null}
function rememberSimulationScore(t,start,score){if(!S.simulationScores)S.simulationScores={};S.simulationScores[t+'|'+start.substr(0,10)]={score:score,at:new Date().getTime()}}
function screenMarketDaily(id,list,name,start,end,rate,mins){var i=0,processed=0,buy=[],sell=[],noHistory=0,errors=[],pending=[],needsCooldown=false,priorEnd=start.substr(0,10)+' 00:00:00',zone='America/Los_Angeles';function record(t,score){processed++;if(score>=8.5)buy.push({t:t,score:score});else if(score<=3)sell.push({t:t,score:score})}for(var seed=0;seed<list.length;seed++){var cachedScore=cachedSimulationScore(list[seed],start);if(cachedScore===null)pending.push(list[seed]);else record(list[seed],cachedScore)}function finish(){if(id!=marketScanId)return;save();if(!buy.length){finishMarketScan(id);renderMarketResult({name:name,total:list.length,start:start,end:end,buy:buy,sell:sell,trades:[],noHistory:noHistory,noBars:0,errors:errors,minutes:mins});return}showScanProgress('Daily screening complete: '+processed+' of '+list.length+' stocks checked. '+buy.length+' buy signal(s) need a 1-minute replay next.');var nextStep=function(){replayBuyCandidates(id,list.length,name,start,end,rate,mins,buy,sell,noHistory,errors)};if(needsCooldown)setTimeout(nextStep,61000);else nextStep()}function next(){if(id!=marketScanId)return;if(i>=pending.length){finish();return}var batch=pending.slice(i,Math.min(i+rate,pending.length));i+=batch.length;needsCooldown=true;showScanProgress('Screening '+processed+' of '+list.length+' stocks. Checking the next '+batch.length+' daily histories...');api('/time_series?symbol='+batchSymbols(batch)+'&interval=1day&end_date='+encodeURIComponent(priorEnd)+'&outputsize=80&timezone='+encodeURIComponent(zone),function(err,j){var z,k,rows,d;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Daily market-data request failed.');noHistory+=batch.length}else for(k=0;k<batch.length;k++){z=batchEntry(j,batch[k]);if(!z||z.status=='error'||!z.values){noHistory++;continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});d=calc(rows);if(!d){noHistory++;continue}rememberSimulationScore(batch[k],start,d.score);record(batch[k],d.score)}showScanProgress('Daily screening: '+processed+' of '+list.length+' stocks checked. Buy signals found: '+buy.length+'.');if(i<pending.length)setTimeout(next,61000);else next()})}if(!pending.length){showScanProgress('Using cached daily scores for '+processed+' stocks. Replaying buy candidates now...');finish()}else next()}
function renderSimulationControls(){onSimulationUniverseChange();var r=document.getElementById('simRate');if(r&&r.value=='6'){r.options[0].value='8';r.options[0].text='Free/Basic - 8 per minute';r.value='8'}}
function setConnection(txt,live){var b=document.getElementById('dataBadge');b.innerHTML='<span class="statusdot '+(live?'live':'')+'"></span> '+txt;b.className='badge '+(live?'ok':'')}
function stockHtml(t,d,full){if(!d)return '<div class="stock"><b>'+esc(t)+'</b><span class="muted"> — Load data to calculate a score</span></div>';var why=d.trend=='Positive'?'The recent price is above its 20-day average.':'The recent price is below its 20-day average.';return '<div class="stock"><div class="row space"><div><b>'+esc(t)+'</b><div class="muted">'+money(d.price)+'</div></div><div class="row"><span class="pill '+signalClass(d.score)+'">'+rating(d.score)+'</span><div class="score">'+d.score.toFixed(1)+'</div></div></div><div class="why"><b>Why this score?</b><br>'+why+' Momentum is '+(d.momentum>1?'strong':d.momentum<-1?'weak':'mixed')+'. Price swings look '+(d.vol<25?'moderate':'higher than usual')+'. <button class="help" onclick="help(\'score\')">What does this mean?</button></div>'+(full?'<div class="advanced-only"><table><tr><th>RSI</th><th>SMA 20</th><th>SMA 50</th><th>Volatility</th><th>Drawdown</th></tr><tr><td>'+d.rsi.toFixed(1)+'</td><td>'+money(d.sma20)+'</td><td>'+money(d.sma50)+'</td><td>'+d.vol.toFixed(1)+'%</td><td>'+d.drawdown.toFixed(1)+'%</td></tr></table></div>':'')+'</div>'}
function renderAll(){var h='';for(var i=0;i<S.watch.length;i++)h+=stockHtml(S.watch[i],quoteCache[S.watch[i]]||null,false);document.getElementById('homeStocks').innerHTML=h||'<div class="empty">Your watchlist is empty.</div>';var wt='<table><tr><th>Symbol</th><th>Score</th><th>View</th><th></th></tr>';for(i=0;i<S.watch.length;i++){var t=S.watch[i],d=quoteCache[t];wt+='<tr><td><b>'+esc(t)+'</b></td><td>'+(d?d.score.toFixed(1):'—')+'</td><td><button class="help" onclick="quickResearch(\''+esc(t)+'\')">Research</button></td><td><button class="btn secondary small" onclick="removeTicker(\''+esc(t)+'\')">Remove</button></td></tr>'}document.getElementById('watchTable').innerHTML=wt+'</table>';renderHoldings();renderWizard();renderPresets();renderTrades();renderAdvanced();document.getElementById('riskHome').innerHTML=S.risk;document.getElementById('portfolioValue').innerHTML=money(portfolioValue())}
function research(){var t=document.getElementById('searchTicker').value.replace(/[^A-Za-z.]/g,'').toUpperCase();if(!t)return;document.getElementById('researchResult').innerHTML='<div class="empty">Loading '+esc(t)+'…</div>';getStock(t,function(err,d){document.getElementById('researchResult').innerHTML=err?'<div class="notice">'+esc(err)+'</div>':stockHtml(t,d,true)+'<div class="row" style="margin-top:12px"><button class="btn" onclick="openTrade(\''+esc(t)+'\')">Practice a paper trade</button></div>';renderAll()})}
function quickResearch(t){goByName('explore');document.getElementById('searchTicker').value=t;research()}
function addFromSearch(){document.getElementById('addTicker').value=document.getElementById('searchTicker').value;addTicker()}
var lastResearchTicker='',SEARCH_ALIASES={TSMC:'TSM',TAIWANSEMICONDUCTOR:'TSM',TAIWANSEMICONDUCTORMANUFACTURING:'TSM',APPLE:'AAPL',MICROSOFT:'MSFT',NVIDIA:'NVDA',TESLA:'TSLA',AMAZON:'AMZN',GOOGLE:'GOOGL',ALPHABET:'GOOGL',META:'META',FACEBOOK:'META',NETFLIX:'NFLX',BERKSHIRE:'BRK.B',ALIBABA:'BABA'};
function searchText(v){return String(v||'').replace(/^\s+|\s+$/g,'')}
function chooseSearchResult(raw,cb){var data=raw&&raw.data?raw.data:[],i,x,t,best='';for(i=0;i<data.length;i++){x=data[i]||{};t=normSymbol(x.symbol||x.ticker||'');if(!t)continue;if(!best)best=t;var country=String(x.country||'').toLowerCase(),exchange=String(x.exchange||'').toLowerCase();if(country=='united states'||country=='usa'||exchange.indexOf('nasdaq')>=0||exchange.indexOf('nyse')>=0){best=t;break}}cb(best?null:'No matching listed symbol was found.',best)}
function resolveResearchTicker(raw,cb){var text=searchText(raw),compact=text.replace(/[^A-Za-z]/g,'').toUpperCase(),direct=normSymbol(text.replace(/[^A-Za-z.]/g,''));if(SEARCH_ALIASES[compact]){cb(null,SEARCH_ALIASES[compact]);return}if(text.indexOf(' ')>=0||!direct){api('/symbol_search?symbol='+encodeURIComponent(text),function(err,j){if(err||!j||j.status=='error'){cb((j&&j.message)||err||'Could not search that company name.');return}chooseSearchResult(j,cb)});return}cb(null,direct)}
/* Shared request budget: queues excess work instead of showing a 429 error to the user. */
var apiUsage=[],apiCreditCap=8,apiCooldownUntil=0;
function apiCost(path){var m=String(path).match(/[?&]symbol=([^&]+)/i),x,i;if(!m)return 1;x=decodeURIComponent(m[1]).split(',');i=x.length;return i>0?i:1}
function apiDelay(cost){var now=new Date().getTime(),i,used=0,freed=0,wait=0;for(i=apiUsage.length-1;i>=0;i--)if(now-apiUsage[i].at>=61000)apiUsage.splice(i,1);if(now<apiCooldownUntil)wait=apiCooldownUntil-now;for(i=0;i<apiUsage.length;i++)used+=apiUsage[i].cost;if(used+cost<=apiCreditCap)return wait;for(i=0;i<apiUsage.length;i++){freed+=apiUsage[i].cost;if(used-freed+cost<=apiCreditCap){wait=Math.max(wait,apiUsage[i].at+61000-now);return wait}}return Math.max(wait,61000)}
function api(path,cb,useQuery,retry,reserved){var cost=apiCost(path),delay;if(!reserved){if(cost>apiCreditCap)apiCreditCap=cost;delay=apiDelay(cost);if(delay>0){setTimeout(function(){api(path,cb,useQuery,retry,false)},delay+100);return}apiUsage.push({at:new Date().getTime(),cost:cost})}var x=new XMLHttpRequest(),done=false,url='https://api.twelvedata.com'+path;if(useQuery)url+=(path.indexOf('?')>=0?'&':'?')+'apikey='+encodeURIComponent(key());function finish(err,data){if(done)return;done=true;cb(err,data)}x.onreadystatechange=function(){if(x.readyState!=4||done)return;if(x.status>=200&&x.status<300){try{finish(null,JSON.parse(x.responseText))}catch(e){finish('Invalid data response')}}else if(x.status==429){apiCooldownUntil=new Date().getTime()+61000;if(!retry){done=true;setTimeout(function(){api(path,cb,useQuery,true,false)},61100)}else finish('Twelve Data is temporarily rate-limited. Please wait one minute and try again.')}else if(!useQuery&&(x.status==0||x.status==401||x.status==403)){api(path,cb,true,retry,true)}else if(!retry&&(x.status==0||x.status>=500)){done=true;setTimeout(function(){api(path,cb,useQuery,true,false)},1500)}else finish('Market-data request failed ('+x.status+').')};try{x.open('GET',url,true);x.timeout=15000;if(!useQuery)x.setRequestHeader('Authorization','apikey '+key());x.ontimeout=function(){if(done)return;done=true;if(!retry)setTimeout(function(){api(path,cb,useQuery,true,false)},1500);else cb('Market-data request timed out.')};x.send()}catch(e){if(!useQuery)api(path,cb,true,retry,true);else finish('Could not request market data.')}}
function finishMarketScan(id){if(id==marketScanId){marketScanRunning=false;apiCreditCap=8;scheduleRefresh()}}
function stopMarketSimulation(){if(!marketScanRunning){showSimulation('There is no market scan running.',false);return}marketScanId++;marketScanRunning=false;apiCreditCap=8;showSimulation('<b>Market scan stopped.</b><br>The paper portfolio was not changed. You can start another scan whenever you are ready.',false);scheduleRefresh()}
function renderSimulationControls(){onSimulationUniverseChange();var r=document.getElementById('simRate');if(r&&r.value=='6'){r.options[0].value='8';r.options[0].text='Free/Basic - 8 per minute';r.value='8'}if(r){apiCreditCap=Math.max(8,Number(r.value));r.onchange=function(){apiCreditCap=Math.max(8,Number(r.value))}}}
function simulationEstimate(n,rate){var m=Math.max(1,Math.ceil(n/rate));if(m>=60)return 'about '+Math.ceil(m/60)+' hours';return m<=1?'about 1 minute':'about '+m+' minutes'}
function runMarketSimulation(){if(marketScanRunning){alert('A market scan is already running. Choose Stop scan before starting a new one.');return}if(!key()){showSimulation('Connect your Twelve Data API key in Settings before running a historical market simulation.',true);return}var start=document.getElementById('simStart').value.replace(/^\s+|\s+$/g,''),end=document.getElementById('simEnd').value.replace(/^\s+|\s+$/g,''),mins=simulationMinutes(start,end),limit=Number(document.getElementById('simLimit').value),rate=Number(document.getElementById('simRate').value);if(!validSimulationTime(start)||!validSimulationTime(end)||mins<1||mins>390){showSimulation('Choose a valid Pacific-time window from 1 minute up to one regular trading day (390 minutes).',true);return}marketScanRunning=true;apiCreditCap=Math.max(8,rate);if(refreshTimer){clearTimeout(refreshTimer);refreshTimer=0}var id=++marketScanId;showScanProgress('Preparing the selected market universe...');getSimulationUniverse(function(err,list,name){if(id!=marketScanId)return;if(err){finishMarketScan(id);showSimulation(esc(err),true);return}var fullCount=list.length;if(limit==0&&rate<=8&&fullCount>100){if(!confirm('Full scan: '+fullCount+' stocks ('+simulationEstimate(fullCount,rate)+'). Scan the faster first 100 instead?')){finishMarketScan(id);showSimulation('Market scan cancelled.',false);return}list=list.slice(0,100);name+=' - fast 100-stock sample'}else if(limit>0&&list.length>limit)list=list.slice(0,limit);if(!list.length){finishMarketScan(id);showSimulation('The selected market universe is empty.',true);return}if(list.length>100&&!confirm('Scan '+list.length+' stocks? Estimated time: '+simulationEstimate(list.length,rate)+'.')){finishMarketScan(id);showSimulation('Market scan cancelled.',false);return}screenMarketDaily(id,list,name,start,end,rate,mins)})}
function renderSimulationControls(){onSimulationUniverseChange();var r=document.getElementById('simRate'),l=document.getElementById('simLimit'),i;if(r&&r.value=='6'){r.options[0].value='8';r.options[0].text='Free/Basic - 8 per minute';r.value='8'}if(r){apiCreditCap=Math.max(8,Number(r.value));r.onchange=function(){apiCreditCap=Math.max(8,Number(r.value))}}if(l)for(i=0;i<l.options.length;i++)if(l.options[i].value=='0')l.options[i].text='All stocks (very slow)'}
function research(){var raw=searchText(document.getElementById('searchTicker').value);if(!raw)return;document.getElementById('researchResult').innerHTML='<div class="empty">Finding '+esc(raw)+'...</div>';resolveResearchTicker(raw,function(err,t){if(err){document.getElementById('researchResult').innerHTML='<div class="notice">'+esc(err)+'</div>';return}lastResearchTicker=t;document.getElementById('searchTicker').value=t;document.getElementById('researchResult').innerHTML='<div class="empty">Loading '+esc(t)+'...</div>';getStock(t,function(loadErr,d){document.getElementById('researchResult').innerHTML=loadErr?'<div class="notice">'+esc(loadErr)+'</div>':stockHtml(t,d,true)+'<div class="row" style="margin-top:16px"><button class="btn" onclick="openTrade(\''+esc(t)+'\')">Practice a paper trade</button></div>';renderAll()})})}
function addFromSearch(){document.getElementById('addTicker').value=lastResearchTicker||document.getElementById('searchTicker').value;addTicker()}
function addTicker(){var e=document.getElementById('addTicker'),t=e.value.replace(/[^A-Za-z.]/g,'').toUpperCase();if(!t)return;if(S.watch.indexOf(t)<0)S.watch.push(t);e.value='';save();getStock(t,function(){renderAll()})}
function removeTicker(t){var n=[];for(var i=0;i<S.watch.length;i++)if(S.watch[i]!=t)n.push(S.watch[i]);S.watch=n;save();renderAll()}
function selectRisk(r){S.risk=r;if(r=='Conservative'){S.maxTrade=500;S.maxLoss=100}else if(r=='Balanced'){S.maxTrade=1000;S.maxLoss=250}else{S.maxTrade=2500;S.maxLoss=500}save();renderAll()}
function renderPresets(){var rs=['Conservative','Balanced','Aggressive'],x='';for(var i=0;i<rs.length;i++)x+='<div class="preset '+(S.risk==rs[i]?'selected':'')+'" onclick="selectRisk(\''+rs[i]+'\')"><b>'+rs[i]+'</b><p class="muted">'+(i==0?'Smaller positions and tighter loss limits.':i==1?'A middle-ground practice setting.':'Larger simulated positions and losses.')+'</p></div>';document.getElementById('presetSettings').innerHTML=x;document.getElementById('customTrade').value=S.maxTrade;document.getElementById('customLoss').value=S.maxLoss}
function saveCustomRisk(){S.maxTrade=Math.max(1,Number(document.getElementById('customTrade').value));S.maxLoss=Math.max(1,Number(document.getElementById('customLoss').value));S.risk='Custom';save();renderAll()}
function renderWizard(){var w=document.getElementById('wizard'),n=S.wizard||1;for(var i=1;i<=4;i++)document.getElementById('st'+i).className='step '+(i==n?'on':'');if(n==1)w.innerHTML='<h2>Choose a risk level</h2><p class="muted">You can change this later.</p><div id="wizPresets"></div><div style="margin-top:18px"><button class="btn" onclick="wizardNext()">Continue</button></div>';else if(n==2)w.innerHTML='<h2>Review safety limits</h2><p>Maximum simulated money per trade: <b>'+money(S.maxTrade)+'</b></p><p>Maximum simulated daily loss: <b>'+money(S.maxLoss)+'</b></p><button class="btn secondary" onclick="wizardBack()">Back</button> <button class="btn" onclick="wizardNext()">Continue</button>';else if(n==3)w.innerHTML='<h2>Choose the practice strategy</h2><p><b>Adaptive Score</b></p><p class="muted">Paper buy when score is 8.5 or higher; paper sell when it is 3.0 or lower. This rule is for testing and is not proven profitable.</p><button class="btn secondary" onclick="wizardBack()">Back</button> <button class="btn" onclick="wizardNext()">Continue</button>';else w.innerHTML='<h2>Review & start</h2><p>Risk: <b>'+S.risk+'</b> • Max per trade: <b>'+money(S.maxTrade)+'</b></p><p class="notice">Automatic paper trading works only while this app is open and market data is available. It never sends broker orders.</p><button class="btn secondary" onclick="wizardBack()">Back</button> <button class="btn" onclick="startPaper()">Start paper trading</button>';if(n==1){var p='';var rs=['Conservative','Balanced','Aggressive'];for(i=0;i<3;i++)p+='<div class="preset '+(S.risk==rs[i]?'selected':'')+'" onclick="selectRisk(\''+rs[i]+'\')"><b>'+rs[i]+'</b><p class="muted">'+(i==0?'Lower exposure':i==1?'Moderate exposure':'Higher exposure')+'</p></div>';document.getElementById('wizPresets').innerHTML=p}}
function wizardNext(){S.wizard=Math.min(4,(S.wizard||1)+1);save();renderWizard()}function wizardBack(){S.wizard=Math.max(1,(S.wizard||1)-1);save();renderWizard()}
function slippage(){return Number(S.slippageBps||5)/10000}
function dailyStopHit(){return dailyState().realized<=-Math.abs(Number(S.maxLoss||0))}
function tradedToday(t,side){var today=dayKey();for(var i=0;i<S.trades.length;i++)if(S.trades[i].day==today&&S.trades[i].t==t&&S.trades[i].side==side)return true;return false}
function recordTrade(side,t,q,p,reason,pnl){S.trades.unshift({d:new Date().toLocaleString(),day:dayKey(),side:side,t:t,q:q,p:p,reason:reason,pnl:pnl||0});if(S.trades.length>250)S.trades.pop();save()}
function buyPaper(t,qty,source){var d=quoteCache[t];if(!d||qty<1)return false;if(dailyStopHit()){if(source=='manual')alert('Daily-loss stop is active. New paper buys are disabled for today.');return false}var p=d.price*(1+slippage()),cost=p*qty;if(cost>S.maxTrade){if(source=='manual')alert('This exceeds your '+S.risk+' limit of '+money(S.maxTrade)+' per trade.');return false}if(cost>S.cash){if(source=='manual')alert('Not enough simulated cash.');return false}S.cash-=cost;if(!S.holdings[t])S.holdings[t]={qty:0,avg:0};var old=S.holdings[t],total=old.qty*old.avg+cost;old.qty+=qty;old.avg=total/old.qty;recordTrade('BUY',t,qty,p,source=='auto'?'Automatic score buy; risk check passed':'Manual paper buy; risk check passed');return true}
function sellPaper(t,qty,source){var d=quoteCache[t],holding=S.holdings[t];if(!d||!holding||qty<1)return false;qty=Math.min(qty,holding.qty);var p=d.price*(1-slippage()),proceeds=p*qty,pnl=(p-holding.avg)*qty;S.cash+=proceeds;holding.qty-=qty;if(holding.qty<=0)delete S.holdings[t];dailyState().realized+=pnl;recordTrade('SELL',t,qty,p,source=='auto'?'Automatic score sell':'Manual paper sell',pnl);return true}
function runAutoPaper(){if(!S.auto||!key()||!S.marketOpen)return;dailyState();for(var i=0;i<S.watch.length;i++){var t=S.watch[i],d=quoteCache[t],holding=S.holdings[t];if(!d)continue;if(d.score>=8.5&&!holding&&!tradedToday(t,'BUY')&&!dailyStopHit()){var q=Math.floor(S.maxTrade/(d.price*(1+slippage())));if(q>0)buyPaper(t,q,'auto')}else if(d.score<=3&&holding&&!tradedToday(t,'SELL'))sellPaper(t,holding.qty,'auto')}save()}
function runAutoPaperFor(list){if(!S.auto||!key()||!S.marketOpen)return;dailyState();for(var i=0;i<list.length;i++){var t=list[i],d=quoteCache[t],holding=S.holdings[t];if(!d||!d.live)continue;if(d.score>=8.5&&!holding&&!tradedToday(t,'BUY')&&!dailyStopHit()){var q=Math.floor(S.maxTrade/(d.price*(1+slippage())));if(q>0)buyPaper(t,q,'auto')}else if(d.score<=3&&holding&&!tradedToday(t,'SELL'))sellPaper(t,holding.qty,'auto')}save()}
function runAutoPaper(){runAutoPaperFor(S.watch)}
function startPaper(){if(!key()){alert('Connect live Twelve Data first. Automatic paper trading never runs on demonstration data.');return}S.auto=true;save();renderTrades();refreshAll();alert('Automatic paper trading is ON. It will check only live quotes while this app remains open.')}
function emergencyStop(){S.auto=false;save();renderTrades();alert('Stopped. No automatic paper trades will be created.')}
function openTrade(t){var d=quoteCache[t];if(!d){alert('Load market data first.');return}var qty=prompt('How many simulated shares of '+t+'?','1');qty=parseInt(qty,10);if(!qty||qty<1)return;if(buyPaper(t,qty,'manual')){renderAll();alert('Paper trade completed. Bought '+qty+' simulated share(s) of '+t+'.')}}
function manualSell(t){var h=S.holdings[t];if(!h)return;var qty=prompt('How many simulated shares of '+t+' should be sold?',''+h.qty);qty=parseInt(qty,10);if(!qty||qty<1)return;if(sellPaper(t,qty,'manual')){save();renderAll();alert('Paper trade completed. Sold '+Math.min(qty,h.qty||qty)+' simulated share(s) of '+t+'.')}}
function portfolioValue(){var v=S.cash;for(var t in S.holdings){var d=quoteCache[t];v+=S.holdings[t].qty*(d?d.price:S.holdings[t].avg)}return v}
function renderHoldings(){var h='<p><b>Cash:</b> '+money(S.cash)+'</p>',any=false;for(var t in S.holdings){any=true;h+='<div class="stock"><div class="row space"><div><b>'+esc(t)+'</b><br><span class="muted">'+S.holdings[t].qty+' shares • avg '+money(S.holdings[t].avg)+'</span></div><button class="btn secondary small" onclick="manualSell(\''+esc(t)+'\')">Sell</button></div></div>'}document.getElementById('holdings').innerHTML=any?h:'<p class="muted">No paper holdings yet.</p>'+h}
function renderTrades(){var h=S.trades.length?'<table><tr><th>Time</th><th>Trade</th><th>Reason</th><th>P/L</th></tr>':'<div class="empty">No paper trades yet.</div>';for(var i=0;i<S.trades.length;i++){var z=S.trades[i],p=z.pnl?'<span class="'+(z.pnl>=0?'green':'red')+'">'+money(z.pnl)+'</span>':'—';h+='<tr><td>'+esc(z.d)+'</td><td><b>'+z.side+' '+z.q+' '+esc(z.t)+'</b><br>'+money(z.p)+'</td><td>'+esc(z.reason)+'</td><td>'+p+'</td></tr>'}if(S.trades.length)h+='</table>';document.getElementById('tradeHistory').innerHTML=h;document.getElementById('autoDot').className='statusdot '+(S.auto?'live':'');document.getElementById('autoStatus').innerHTML='Automatic paper trading is '+(S.auto?'ON':'OFF')+(dailyStopHit()?' • Daily-loss stop active':'')}
function renderAdvanced(){var arr=[],t,d;for(t in quoteCache)arr.push({t:t,d:quoteCache[t]});arr.sort(function(a,b){return b.d.score-a.d.score});var h='<table><tr><th>Rank</th><th>Symbol</th><th>Score</th><th>Technical</th><th>Low Risk</th></tr>';for(var i=0;i<arr.length;i++)h+='<tr><td>'+(i+1)+'</td><td>'+esc(arr[i].t)+'</td><td><b>'+arr[i].d.score.toFixed(1)+'</b></td><td>'+arr[i].d.technical.toFixed(1)+'</td><td>'+arr[i].d.lowrisk.toFixed(1)+'</td></tr>';document.getElementById('rankings').innerHTML=arr.length?h+'</table>':'<div class="empty">Refresh data to build rankings.</div>';var ev='';for(t in S.history){ev+='<p><b>'+esc(t)+'</b>: ';for(i=0;i<S.history[t].length;i++)ev+='<span class="pill">'+S.history[t][i].s+'</span> ';ev+='</p>'}document.getElementById('evolution').innerHTML=ev||'<div class="empty">Score history appears after live refreshes.</div>';if(arr.length){d=arr[0].d;var fs=[['Trend',d.trend=='Positive'?8:3],['Momentum',Math.max(1,Math.min(10,5+d.momentum/2))],['RSI balance',d.rsi>75?3:7],['Low volatility',d.lowrisk]];h='<p class="muted">Top-ranked: '+esc(arr[0].t)+'</p>';for(i=0;i<fs.length;i++)h+='<p>'+fs[i][0]+' <b style="float:right">'+fs[i][1].toFixed(1)+'/10</b></p><div class="factorbar"><i style="width:'+(fs[i][1]*10)+'%"></i></div>';document.getElementById('factors').innerHTML=h}else document.getElementById('factors').innerHTML='<div class="empty">No factor data yet.</div>';document.getElementById('riskDetails').innerHTML='<p>Preset: <b>'+S.risk+'</b></p><p>Maximum per trade: <b>'+money(S.maxTrade)+'</b></p><p>Daily-loss stop: <b>'+money(S.maxLoss)+'</b></p><p>Paper automation: <b>'+(S.auto?'ON':'OFF')+'</b></p>'}
function saveKeyAndConnect(){var v=document.getElementById('apiKey').value.replace(/^\s+|\s+$/g,'');if(!v){document.getElementById('connectionMsg').innerHTML='Enter an API key first.';return}setKey(v);document.getElementById('connectionMsg').innerHTML='Testing connection…';api('/quote?symbol=AAPL',function(err,j){if(err||!j||j.status=='error'){document.getElementById('connectionMsg').innerHTML='<span class="red">Could not connect: '+esc((j&&j.message)||err||'Unknown error')+'</span>';setConnection('Connection failed',false)}else{document.getElementById('connectionMsg').innerHTML='<span class="green">Connected successfully.</span>';setConnection('Live data connected',true);refreshAll()}})}
function forgetKey(){setKey('');document.getElementById('apiKey').value='';setConnection('Demo data',false);document.getElementById('connectionMsg').innerHTML='Saved key removed.'}
function openSignup(){new ActiveXObject('WScript.Shell').Run('https://twelvedata.com/register',1,false)}
function appFolder(){var p=unescape(location.pathname).replace(/\//g,'\\');if(p.charAt(0)=='\\')p=p.substr(1);return new ActiveXObject('Scripting.FileSystemObject').GetParentFolderName(p)}
function checkForUpdates(){var fso=new ActiveXObject('Scripting.FileSystemObject'),updater=appFolder()+'\\Update Adaptive Trader.vbs';if(!fso.FileExists(updater)){alert('The update helper is missing. Please extract the complete Adaptive Trader folder again.');return}try{new ActiveXObject('WScript.Shell').Run('wscript.exe "'+updater+'"',0,false);window.setTimeout(function(){window.close()},250)}catch(e){alert('Windows could not start the updater. The current app is still open.')}}
function resetApp(){if(confirm('Reset watchlist, paper portfolio, trades, and settings? The API key will be kept.')){S=clone(defaults);save();quoteCache={};applyMode();renderAll()}}
function help(k){var title='What does this mean?',body='';if(k=='score'){title='About the Adaptive Score';body='<p>The score combines <b>72% technical conditions</b> and <b>28% low-risk conditions</b>. Technical conditions use moving-average trend, 10-day momentum, and RSI. Low-risk conditions use recent volatility and drawdown.</p><p>It is an original, transparent model built for this app. It is inspired by the idea of explainable 1–10 research, but it does not copy Danelfin’s proprietary model and does not predict returns.</p>'}else if(k=='rsi')body='<p>RSI ranges from 0 to 100. This app uses the latest 14 daily moves. A high value can mean strong momentum, but readings above roughly 70 may also mean the move is stretched. RSI alone is not a buy or sell signal.</p>';else body='<p>This is the change in your simulated portfolio for the current session. It is not real money and excludes taxes, fees, and slippage.</p>';document.getElementById('modalTitle').innerHTML=title;document.getElementById('modalBody').innerHTML=body;document.getElementById('modalBg').style.display='block'}
function help(k){var title='What does this mean?',body='';if(k=='replay'){title='About historical market simulation';body='<p>The market scan first calculates each selected stock\'s Adaptive Score from daily prices available before the selected window. A score of 8.5 or higher is a potential paper buy. It then replays 1-minute prices in the Pacific-time window for those buy candidates.</p><p>Results show the stocks actually bought in a $100,000 cash-only model, using the current per-trade limit and slippage setting. Sell signals are reported but cannot execute because the replay begins with no holdings. The replay never changes your paper portfolio.</p><p>The all-market option uses a current U.S. common-stock listing, so it does not include delisted or renamed stocks and is not a survivorship-bias-free backtest. Large scans are deliberately paced for your Twelve Data plan.</p>'}else if(k=='score'){title='About the Adaptive Score';body='<p>The score combines <b>72% technical conditions</b> and <b>28% low-risk conditions</b>. Technical conditions use moving-average trend, 10-day momentum, and RSI. Low-risk conditions use recent volatility and drawdown.</p><p>It is an original, transparent model built for this app. It does not copy Danelfin’s proprietary model and does not predict returns.</p>'}else if(k=='rsi'){title='About RSI';body='<p>RSI ranges from 0 to 100. This app uses the latest 14 daily moves. A high value can mean strong momentum, but readings above roughly 70 may also mean the move is stretched. RSI alone is not a buy or sell signal.</p>'}else body='<p>This is the change in your simulated portfolio for the current session. It is not real money and excludes taxes, fees, and slippage.</p>';document.getElementById('modalTitle').innerHTML=title;document.getElementById('modalBody').innerHTML=body;document.getElementById('modalBg').style.display='block'}
function closeModal(){document.getElementById('modalBg').style.display='none'}
function init(){var hr=new Date().getHours();document.getElementById('daypart').innerHTML=hr<12?'morning':hr<18?'afternoon':'evening';document.getElementById('apiKey').value=key();applyFontSize();applyMode();renderFontControl();renderAll();if(key()){setConnection('Saved key ready',true);refreshAll()}else{setConnection('Demo data',false);refreshAll()}document.getElementById('marketState').innerHTML='U.S. Market';document.getElementById('marketDetail').innerHTML='Status follows live data availability'}
/* Reliable help windows and faster, plan-safe data handling. */
function helpText(k){var x={daily:{title:'Today\'s simulated change',body:'<p>This is the change in your simulated portfolio for the current session. It is not real money and excludes taxes, fees, and slippage.</p>'},score:{title:'About the Adaptive Score',body:'<p>The score combines <b>72% technical conditions</b> and <b>28% low-risk conditions</b>. It uses moving-average trend, 10-day momentum, RSI, volatility, and drawdown.</p><p>It is this app\'s original research summary. It does not predict returns or guarantee a gain.</p>'},rsi:{title:'About RSI',body:'<p>RSI ranges from 0 to 100 and compares recent upward and downward moves. A very high or low reading can show a move is stretched, but RSI alone is not a buy or sell signal.</p>'},replay:{title:'How historical market simulation works',body:'<p>The app calculates each stock\'s score using only daily prices available before your selected time window. A score of 8.5 or higher is a potential simulated buy.</p><p>Only those potential buys receive a 1-minute replay. The replay begins with simulated cash, uses your risk limit and slippage setting, and never changes your paper portfolio.</p><p>Data requests are paced to stay within the Twelve Data plan you selected. Use the Fast preview for a quick check; larger scans take longer because each stock needs its own historical data credit.</p>'}};return x[k]||x.daily}
function showHelp(k){var x=helpText(k),bg=document.getElementById('modalBg'),title=document.getElementById('modalTitle'),body=document.getElementById('modalBody');if(!bg||!title||!body){alert(x.title+'\n\n'+String(x.body).replace(/<[^>]*>/g,''));return false}title.innerHTML=x.title;body.innerHTML=x.body;bg.style.position='fixed';bg.style.left='0px';bg.style.top='0px';bg.style.right='0px';bg.style.bottom='0px';bg.style.width='100%';bg.style.height='100%';bg.style.zIndex='1000';bg.style.display='block';return false}
function help(k){return showHelp(k)}
function closeModal(){var bg=document.getElementById('modalBg');if(bg)bg.style.display='none'}
function helpKeyFor(el){var label=String(el.innerText||el.textContent||'').toLowerCase(),context=String((el.parentNode&&el.parentNode.innerText)||'').toLowerCase();if(label.indexOf('how does')>=0)return 'replay';if(label.indexOf('more detail')>=0)return 'score';if(context.indexOf('rsi')>=0)return 'rsi';if(context.indexOf('score')>=0)return 'score';return 'daily'}
function wireHelpLinks(){var links=document.getElementsByClassName('help'),i,el,k,label;for(i=0;i<links.length;i++){el=links[i];label=String(el.innerText||el.textContent||'').toLowerCase();if(label.indexOf('what')<0&&label.indexOf('how does')<0&&label.indexOf('more detail')<0)continue;k=helpKeyFor(el);el.onclick=(function(keyName){return function(){return showHelp(keyName)}})(k)}}
function renderAll(){var h='';for(var i=0;i<S.watch.length;i++)h+=stockHtml(S.watch[i],quoteCache[S.watch[i]]||null,false);document.getElementById('homeStocks').innerHTML=h||'<div class="empty">Your watchlist is empty.</div>';var wt='<table><tr><th>Symbol</th><th>Score</th><th>View</th><th></th></tr>';for(i=0;i<S.watch.length;i++){var t=S.watch[i],d=quoteCache[t];wt+='<tr><td><b>'+esc(t)+'</b></td><td>'+(d?d.score.toFixed(1):'-')+'</td><td><button class="help" onclick="quickResearch(\''+esc(t)+'\')">Research</button></td><td><button class="btn secondary small" onclick="removeTicker(\''+esc(t)+'\')">Remove</button></td></tr>'}document.getElementById('watchTable').innerHTML=wt+'</table>';renderHoldings();renderWizard();renderPresets();renderTrades();renderAdvanced();document.getElementById('riskHome').innerHTML=S.risk;document.getElementById('portfolioValue').innerHTML=money(portfolioValue());wireHelpLinks()}
function simulationEstimate(n,rate){var m=Math.max(1,Math.ceil(n/Math.max(1,rate)));if(m>=60)return 'about '+Math.ceil(m/60)+' hours';return m==1?'about 1 minute':'about '+m+' minutes'}
function renderSimulationControls(){onSimulationUniverseChange();var r=document.getElementById('simRate'),l=document.getElementById('simLimit'),i,o;if(r&&r.value=='6'){r.options[0].value='8';r.options[0].text='Free/Basic - 8 per minute';r.value='8'}if(r){apiCreditCap=Math.max(8,Number(r.value));r.onchange=function(){apiCreditCap=Math.max(8,Number(r.value))}}if(!l)return;if(!l._adaptiveFastOptions){o=document.createElement('option');o.value='8';o.text='Fast preview - 8 stocks';l.insertBefore(o,l.options[0]);o=document.createElement('option');o.value='25';o.text='25 stocks';l.insertBefore(o,l.options[1]);l.value='8';l._adaptiveFastOptions=true}for(i=0;i<l.options.length;i++)if(l.options[i].value=='0')l.options[i].text='All stocks (very slow)'}
function runMarketSimulation(){if(marketScanRunning){alert('A market scan is already running. Choose Stop scan before starting a new one.');return}if(!key()){showSimulation('Connect your Twelve Data API key in Settings before running a historical market simulation.',true);return}var start=document.getElementById('simStart').value.replace(/^\s+|\s+$/g,''),end=document.getElementById('simEnd').value.replace(/^\s+|\s+$/g,''),mins=simulationMinutes(start,end),limit=Number(document.getElementById('simLimit').value),rate=Number(document.getElementById('simRate').value),universe=document.getElementById('simUniverse').value;if(!validSimulationTime(start)||!validSimulationTime(end)||mins<1||mins>390){showSimulation('Choose a valid Pacific-time window from 1 minute up to one regular trading day (390 minutes).',true);return}marketScanRunning=true;apiCreditCap=Math.max(8,rate);if(refreshTimer){clearTimeout(refreshTimer);refreshTimer=0}var id=++marketScanId;showScanProgress('Preparing the selected market universe...');getSimulationUniverse(function(err,list,name){var fullCount,fastCount;if(id!=marketScanId)return;if(err){finishMarketScan(id);showSimulation(esc(err),true);return}fullCount=list.length;fastCount=Math.min(Math.max(1,rate),fullCount);if(universe=='listing'&&limit==0&&rate<=8&&fullCount>fastCount){if(!confirm('A full scan of '+fullCount+' stocks takes '+simulationEstimate(fullCount,rate)+'. Run the fast '+fastCount+'-stock preview instead?')){finishMarketScan(id);showSimulation('Market scan cancelled.',false);return}list=list.slice(0,fastCount);name+=' - fast '+fastCount+'-stock preview'}else if(limit>0&&list.length>limit)list=list.slice(0,limit);if(!list.length){finishMarketScan(id);showSimulation('The selected market universe is empty.',true);return}if(list.length>rate&&!confirm('Screen '+list.length+' stocks? Estimated daily screening time: '+simulationEstimate(list.length,rate)+'.')){finishMarketScan(id);showSimulation('Market scan cancelled.',false);return}screenMarketDaily(id,list,name,start,end,rate,mins)})}
function screenMarketDaily(id,list,name,start,end,rate,mins){var i=0,processed=0,buy=[],sell=[],noHistory=0,errors=[],pending=[],priorEnd=start.substr(0,10)+' 00:00:00',zone='America/Los_Angeles';function record(t,score){processed++;if(score>=8.5)buy.push({t:t,score:score});else if(score<=3)sell.push({t:t,score:score})}function finish(){if(id!=marketScanId)return;save();if(!buy.length){finishMarketScan(id);renderMarketResult({name:name,total:list.length,start:start,end:end,buy:buy,sell:sell,trades:[],noHistory:noHistory,noBars:0,errors:errors,minutes:mins});return}showScanProgress('Daily screening complete: '+processed+' of '+list.length+' stocks checked. '+buy.length+' buy signal(s) need a 1-minute replay next.');replayBuyCandidates(id,list.length,name,start,end,rate,mins,buy,sell,noHistory,errors)}function next(){var batch;if(id!=marketScanId)return;if(i>=pending.length){finish();return}batch=pending.slice(i,Math.min(i+rate,pending.length));i+=batch.length;showScanProgress('Screening '+processed+' of '+list.length+' stocks. Checking the next '+batch.length+' daily histories...');api('/time_series?symbol='+batchSymbols(batch)+'&interval=1day&end_date='+encodeURIComponent(priorEnd)+'&outputsize=80&timezone='+encodeURIComponent(zone),function(err,j){var z,k,rows,d;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Daily market-data request failed.');noHistory+=batch.length}else for(k=0;k<batch.length;k++){z=batchEntry(j,batch[k]);if(!z||z.status=='error'||!z.values){noHistory++;continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});d=calc(rows);if(!d){noHistory++;continue}rememberSimulationScore(batch[k],start,d.score);record(batch[k],d.score)}showScanProgress('Daily screening: '+processed+' of '+list.length+' stocks checked. Buy signals found: '+buy.length+'.');next()})}for(var seed=0;seed<list.length;seed++){var cachedScore=cachedSimulationScore(list[seed],start);if(cachedScore===null)pending.push(list[seed]);else record(list[seed],cachedScore)}if(!pending.length)showScanProgress('Using cached daily scores for '+processed+' stocks. Replaying buy candidates now...');next()}
function replayBuyCandidates(id,total,name,start,end,rate,mins,buy,sell,noHistory,errors){var i=0,processed=0,trades=[],noBars=0,zone='America/Los_Angeles',outsize=Math.max(20,Math.min(5000,mins+10));function next(){var batch,symbols=[],k;if(id!=marketScanId)return;if(i>=buy.length){finishMarketScan(id);renderMarketResult({name:name,total:total,start:start,end:end,buy:buy,sell:sell,trades:trades,noHistory:noHistory,noBars:noBars,errors:errors,minutes:mins});return}batch=buy.slice(i,Math.min(i+rate,buy.length));for(k=0;k<batch.length;k++)symbols.push(batch[k].t);i+=batch.length;showScanProgress('Replaying 1-minute prices for '+processed+' of '+buy.length+' buy candidate(s)...');api('/time_series?symbol='+batchSymbols(symbols)+'&interval=1min&start_date='+encodeURIComponent(start)+'&end_date='+encodeURIComponent(end)+'&outputsize='+outsize+'&timezone='+encodeURIComponent(zone),function(err,j){var z,rows,usable,q,first,last,fill,cand;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'One-minute market-data request failed.')}else for(k=0;k<batch.length;k++){cand=batch[k];z=batchEntry(j,cand.t);if(!z||z.status=='error'||!z.values){noBars++;continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)<String(b.datetime)?-1:String(a.datetime)>String(b.datetime)?1:0});usable=[];for(q=0;q<rows.length;q++)if(String(rows[q].datetime)>=start&&String(rows[q].datetime)<end&&isFinite(Number(rows[q].close)))usable.push(rows[q]);if(!usable.length){noBars++;continue}first=Number(usable[0].close);last=Number(usable[usable.length-1].close);fill=first*(1+slippage());q=Math.floor(S.maxTrade/fill);if(q>0)trades.push({t:cand.t,score:cand.score,shares:q,entry:fill,exit:last,pnl:(last-fill)*q,bars:usable.length})}processed+=batch.length;showScanProgress('1-minute replay: '+processed+' of '+buy.length+' buy candidate(s) checked.');next()})}next()}
function researchQuote(t,d,j){var p=Number(j&&((j.close||j.price)||j.last));if(!isFinite(p)||p<=0)return false;d.price=p;d.asOf=j.datetime||new Date().toLocaleString();d.marketOpen=j.is_market_open===true||String(j.is_market_open).toLowerCase()=='true';d.live=true;quoteCache[t]=d;S.marketOpen=d.marketOpen;saveScore(t,d);return true}
function getResearchStock(t,cb){t=t.toUpperCase();if(!key()){var demoData=calc(demo(t));demoData.asOf='Demonstration data';demoData.marketOpen=false;quoteCache[t]=demoData;cb(null,demoData);return}var cached=quoteCache[t],age=cached&&cached.historyAt?(new Date().getTime()-cached.historyAt):999999999,dailyDone=false,quoteDone=false,dailyData=null,quoteData=null,dailyError='',sent=false,quoteSent=false;function publish(){if(!dailyDone)return;if(!dailyData){if(quoteDone)cb(dailyError||'No daily history');return}if(quoteDone&&researchQuote(t,dailyData,quoteData)){if(!sent){sent=true;quoteSent=true;cb(null,dailyData)}else if(!quoteSent){quoteSent=true;cb(null,dailyData)}return}if(!sent){dailyData.asOf='Latest daily close';dailyData.live=false;quoteCache[t]=dailyData;saveScore(t,dailyData);sent=true;cb(null,dailyData)}}if(cached&&age<21600000){dailyData=cached;dailyDone=true;publish();api('/quote?symbol='+encodeURIComponent(t),function(err,j){quoteDone=true;quoteData=err?null:j;if(!err&&j&&j.status!='error'){quoteSent=false;publish()}});return}api('/time_series?symbol='+encodeURIComponent(t)+'&interval=1day&outputsize=80',function(err,j){if(err||!j||j.status=='error'||!j.values)dailyError=(j&&j.message)||err||'No daily history';else{var rows=j.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});dailyData=calc(rows);if(!dailyData)dailyError='Not enough valid daily data.';else dailyData.historyAt=new Date().getTime()}dailyDone=true;publish()});api('/quote?symbol='+encodeURIComponent(t),function(err,j){quoteDone=true;quoteData=err?null:j;publish()})}
var activeResearchId=0;
function research(){var raw=searchText(document.getElementById('searchTicker').value),id;if(!raw)return;id=++activeResearchId;document.getElementById('researchResult').innerHTML='<div class="empty">Finding '+esc(raw)+'...</div>';resolveResearchTicker(raw,function(err,t){if(id!=activeResearchId)return;if(err){document.getElementById('researchResult').innerHTML='<div class="notice">'+esc(err)+'</div>';return}lastResearchTicker=t;document.getElementById('searchTicker').value=t;document.getElementById('researchResult').innerHTML='<div class="empty">Loading '+esc(t)+'...</div>';getResearchStock(t,function(loadErr,d){if(id!=activeResearchId)return;document.getElementById('researchResult').innerHTML=loadErr?'<div class="notice">'+esc(loadErr)+'</div>':stockHtml(t,d,true)+'<div class="row" style="margin-top:16px"><button class="btn" onclick="openTrade(\''+esc(t)+'\')">Practice a paper trade</button></div>';renderAll()})})}
/* Keep interactive research responsive and make watchlist additions immediate. */
function addWatchTicker(){var e=document.getElementById('addTicker'),t=normSymbol(String(e?e.value:'').replace(/[^A-Za-z.]/g,'')),i,exists=false;if(!t){if(e)e.focus();return false}for(i=0;i<S.watch.length;i++)if(S.watch[i]==t)exists=true;if(exists){e.value='';alert(t+' is already in your watchlist.');return false}S.watch.push(t);e.value='';save();renderAll();getStock(t,function(){renderAll()});return false}
function wireWatchlistAdd(){var input=document.getElementById('addTicker'),parent,buttons,i,label;if(!input)return;parent=input.parentNode;if(!parent)return;buttons=parent.getElementsByTagName('button');for(i=0;i<buttons.length;i++){label=String(buttons[i].innerText||buttons[i].textContent||'').replace(/^\s+|\s+$/g,'').toLowerCase();if(label=='add')buttons[i].onclick=function(){return addWatchTicker()}}}
function wireHelpLinks(){var links=document.getElementsByClassName('help'),i,el,k,label;for(i=0;i<links.length;i++){el=links[i];label=String(el.innerText||el.textContent||'').toLowerCase();if(label.indexOf('what')<0&&label.indexOf('how does')<0&&label.indexOf('more detail')<0)continue;k=helpKeyFor(el);el.onclick=(function(keyName){return function(){return showHelp(keyName)}})(k)}wireWatchlistAdd()}
function addFromSearch(){var e=document.getElementById('addTicker');if(e)e.value=lastResearchTicker||document.getElementById('searchTicker').value;return addWatchTicker()}
function saveKeyAndConnect(){var v=document.getElementById('apiKey').value.replace(/^\s+|\s+$/g,'');if(!v){document.getElementById('connectionMsg').innerHTML='Enter an API key first.';return}setKey(v);document.getElementById('connectionMsg').innerHTML='Testing connection...';api('/quote?symbol=AAPL',function(err,j){if(err||!j||j.status=='error'){document.getElementById('connectionMsg').innerHTML='<span class="red">Could not connect: '+esc((j&&j.message)||err||'Unknown error')+'</span>';setConnection('Connection failed',false)}else{document.getElementById('connectionMsg').innerHTML='<span class="green">Connected. Explore a stock or use Refresh data for the watchlist.</span>';setConnection('Live data connected',true)}})}
function init(){var hr=new Date().getHours();document.getElementById('daypart').innerHTML=hr<12?'morning':hr<18?'afternoon':'evening';document.getElementById('apiKey').value=key();applyFontSize();applyMode();renderFontControl();renderAll();if(key()){setConnection('Saved key ready',true);document.getElementById('marketDetail').innerHTML='Ready for research. Use Refresh data to update the watchlist.'}else{setConnection('Demo data',false);refreshAll()}document.getElementById('marketState').innerHTML='U.S. Market';if(!key())document.getElementById('marketDetail').innerHTML='Status follows live data availability'}
/* Automatic watchlist refresh without using all data capacity before Explore can run. */
function scheduleRefresh(wait){if(refreshTimer)clearTimeout(refreshTimer);if(!key())return;var delay=Number(wait)|| (S.marketOpen?60000:900000);refreshTimer=setTimeout(function(){refreshAll(true)},delay)}
function refreshAll(forceQuotes){if(refreshing)return;refreshing=true;setConnection('Refreshing live data...',false);var list=S.watch.slice(0),need=[],errors=[],i,cached,age,hi=0,qi=0,dailyOnly=forceQuotes===false;function finish(message){refreshing=false;S.lastRefresh=new Date().toLocaleString();save();if(errors.length){setConnection('Data issue',false);document.getElementById('marketDetail').innerHTML='Last refresh '+S.lastRefresh+' - '+errors[0]}else{setConnection(key()?'Live data':'Demo data',!!key());document.getElementById('marketDetail').innerHTML=message||('Refreshed '+S.lastRefresh)}renderAll();if(dailyOnly)scheduleRefresh(60000);else scheduleRefresh()}if(!key()){for(i=0;i<list.length;i++){cached=calc(demo(list[i]));cached.asOf='Demonstration data';cached.marketOpen=false;quoteCache[list[i]]=cached}finish('Demonstration data loaded');return}for(i=0;i<list.length;i++){cached=quoteCache[list[i]];age=cached&&cached.historyAt?(new Date().getTime()-cached.historyAt):999999999;if(!cached||age>=21600000)need.push(list[i])}function quotes(){if(qi>=list.length){finish('Live watchlist refreshed '+S.lastRefresh);return}var batch=list.slice(qi,Math.min(qi+LIVE_BATCH_SIZE,list.length));qi+=batch.length;fastQuoteBatch(batch,function(es){for(var n=0;n<es.length;n++)errors.push(es[n]);runAutoPaperFor(batch);if(qi<list.length)quotes();else finish('Live watchlist refreshed '+S.lastRefresh)})}function histories(){if(hi>=need.length){if(dailyOnly&&need.length){finish('Daily research loaded. Live quotes will refresh automatically in one minute.');return}quotes();return}var batch=need.slice(hi,Math.min(hi+LIVE_BATCH_SIZE,need.length));hi+=batch.length;fastHistoryBatch(batch,function(es){for(var n=0;n<es.length;n++)errors.push(es[n]);histories()})}histories()}
function startAutomaticRefresh(){if(key())refreshAll(true)}
function saveKeyAndConnect(){var v=document.getElementById('apiKey').value.replace(/^\s+|\s+$/g,'');if(!v){document.getElementById('connectionMsg').innerHTML='Enter an API key first.';return}setKey(v);document.getElementById('connectionMsg').innerHTML='Testing connection...';api('/quote?symbol=AAPL',function(err,j){if(err||!j||j.status=='error'){document.getElementById('connectionMsg').innerHTML='<span class="red">Could not connect: '+esc((j&&j.message)||err||'Unknown error')+'</span>';setConnection('Connection failed',false)}else{document.getElementById('connectionMsg').innerHTML='<span class="green">Connected. Watchlist refresh is now automatic.</span>';setConnection('Live data connected',true);startAutomaticRefresh()}})}
function init(){var hr=new Date().getHours();document.getElementById('daypart').innerHTML=hr<12?'morning':hr<18?'afternoon':'evening';document.getElementById('apiKey').value=key();applyFontSize();applyMode();renderFontControl();renderAll();if(key()){setConnection('Saved key ready',true);document.getElementById('marketDetail').innerHTML='Automatic watchlist refresh is starting.';startAutomaticRefresh()}else{setConnection('Demo data',false);refreshAll()}document.getElementById('marketState').innerHTML='U.S. Market';if(!key())document.getElementById('marketDetail').innerHTML='Status follows live data availability'}
/* Live watchlist movement and a plan-paced U.S. large-cap 100 scanner. */
if(!S.scanUniverse)S.scanUniverse='watch';if(!S.liveScanRate)S.liveScanRate=8;if(typeof S.liveScanCursor=='undefined')S.liveScanCursor=0;
var marketScannerTimer=0,marketScannerBusy=false,marketScannerRun=0;
function fastQuoteBatch(batch,cb){api('/quote?symbol='+batchSymbols(batch),function(err,j){var errors=[],i,t,q,d,p,open,known=false,anyOpen=false,old,hadLive;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Quote request failed.')}else for(i=0;i<batch.length;i++){t=batch[i];q=batchEntry(j,t);d=quoteCache[t];if(!q||q.status=='error'||!d){errors.push(t+': no quote');continue}p=Number(q.close||q.price||q.last);if(!isFinite(p)||p<=0){errors.push(t+': invalid quote');continue}old=Number(d.price);hadLive=d.live===true&&isFinite(old)&&old>0;d.prevPrice=hadLive?old:0;d.priceMove=hadLive?p-old:0;d.priceMovePct=hadLive?(p-old)/old*100:0;if(typeof q.is_market_open!='undefined'){known=true;open=q.is_market_open===true||String(q.is_market_open).toLowerCase()=='true';if(open)anyOpen=true;d.marketOpen=open}d.price=p;d.asOf=q.datetime||new Date().toLocaleString();d.live=true;quoteCache[t]=d}if(known)S.marketOpen=anyOpen;document.getElementById('marketState').innerHTML=S.marketOpen?'<span class="green">OPEN</span>':'CLOSED';document.getElementById('marketDetail').innerHTML=S.marketOpen?'Latest live quotes received':'Showing the latest available quotes';cb(errors)})}
function stockHtml(t,d,full){if(!d)return '<div class="stock"><b>'+esc(t)+'</b><span class="muted"> - Load data to calculate a score</span></div>';var why=d.trend=='Positive'?'The recent price is above its 20-day average.':'The recent price is below its 20-day average.',move='',delta=Number(d.priceMove||0);if(d.live){if(d.prevPrice&&isFinite(delta)&&delta!=0)move=' <span class="'+(delta>0?'green':'red')+'">'+(delta>0?'+':'')+money(delta)+' ('+(delta>0?'+':'')+Number(d.priceMovePct||0).toFixed(2)+'%)</span>';else move=' <span class="blue">Live</span>'}return '<div class="stock"><div class="row space"><div><b>'+esc(t)+'</b><div class="muted">'+money(d.price)+move+'</div><div class="muted" style="font-size:.86em">'+(d.live?'Updated '+esc(d.asOf||'now'):'Latest daily close')+'</div></div><div class="row"><span class="pill '+signalClass(d.score)+'">'+rating(d.score)+'</span><div class="score">'+d.score.toFixed(1)+'</div></div></div><div class="why"><b>Why this score?</b><br>'+why+' Momentum is '+(d.momentum>1?'strong':d.momentum<-1?'weak':'mixed')+'. Price swings look '+(d.vol<25?'moderate':'higher than usual')+'. <button class="help" onclick="showHelp(\'score\')">What does this mean?</button></div>'+(full?'<div class="advanced-only"><table><tr><th>RSI</th><th>SMA 20</th><th>SMA 50</th><th>Volatility</th><th>Drawdown</th></tr><tr><td>'+d.rsi.toFixed(1)+'</td><td>'+money(d.sma20)+'</td><td>'+money(d.sma50)+'</td><td>'+d.vol.toFixed(1)+'%</td><td>'+d.drawdown.toFixed(1)+'%</td></tr></table></div>':'')+'</div>'}
function scannerRate(){var r=Number(S.liveScanRate||8);return r==20||r==60?r:8}
function scannerStatus(){return S.scannerStatus||'Watchlist-only scanning is selected.'}
function setLiveScanUniverse(v){S.scanUniverse=v=='top100'?'top100':'watch';S.liveScanCursor=0;S.scannerStatus=S.scanUniverse=='top100'?'Top 100 scan is preparing.':'Watchlist-only scanning is selected.';marketScannerRun++;marketScannerBusy=false;if(marketScannerTimer){clearTimeout(marketScannerTimer);marketScannerTimer=0}save();renderAll();if(S.scanUniverse=='top100')startLiveMarketScanner()}
function setLiveScanRate(v){var r=Number(v);S.liveScanRate=r==20||r==60?r:8;apiCreditCap=scannerRate();S.liveScanCursor=0;S.scannerStatus='Top 100 scan pace set to '+scannerRate()+' stocks per minute.';marketScannerRun++;marketScannerBusy=false;if(marketScannerTimer){clearTimeout(marketScannerTimer);marketScannerTimer=0}save();renderAll();if(S.scanUniverse=='top100')startLiveMarketScanner()}
function renderPresets(){var rs=['Conservative','Balanced','Aggressive'],x='',i,scan=S.scanUniverse=='top100'?'top100':'watch',rate=scannerRate();for(i=0;i<rs.length;i++)x+='<div class="preset '+(S.risk==rs[i]?'selected':'')+'" onclick="selectRisk(\''+rs[i]+'\')"><b>'+rs[i]+'</b><p class="muted">'+(i==0?'Smaller positions and tighter loss limits.':i==1?'A middle-ground practice setting.':'Larger simulated positions and losses.')+'</p></div>';x+='<div class="notice" style="margin-top:18px"><b>Automatic market scan</b><p class="muted">The watchlist always receives live price updates. Choose the Top 100 option to also rotate through the built-in U.S. large-cap 100 for paper-trade signals.</p><label>Scan coverage</label><select class="input wide" onchange="setLiveScanUniverse(this.value)"><option value="watch" '+(scan=='watch'?'selected':'')+'>Watchlist only</option><option value="top100" '+(scan=='top100'?'selected':'')+'>U.S. large-cap 100</option></select><label style="display:block;margin-top:12px">Data-plan pace</label><select class="input wide" onchange="setLiveScanRate(this.value)"><option value="8" '+(rate==8?'selected':'')+'>Free/Basic - 8 stocks per minute</option><option value="20" '+(rate==20?'selected':'')+'>Higher plan - 20 stocks per minute</option><option value="60" '+(rate==60?'selected':'')+'>Professional plan - 60 stocks per minute</option></select><p class="muted" style="margin-bottom:0">'+esc(scannerStatus())+'</p></div>';document.getElementById('presetSettings').innerHTML=x;document.getElementById('customTrade').value=S.maxTrade;document.getElementById('customLoss').value=S.maxLoss}
function startLiveMarketScanner(){if(S.scanUniverse!='top100'||!key()||marketScanRunning||marketScannerBusy||marketScannerTimer)return;scanTop100Batch()}
function scanTop100Batch(){if(S.scanUniverse!='top100'||!key()||marketScanRunning)return;var all=US_LARGE_CAP_100,rate=scannerRate(),cursor=Number(S.liveScanCursor||0),batch=[],i,t,d,need=[],candidates=[];if(cursor<0||cursor>=all.length)cursor=0;for(i=0;i<rate&&i<all.length;i++)batch.push(all[(cursor+i)%all.length]);marketScannerBusy=true;apiCreditCap=rate;S.scannerStatus='Top 100 scan: preparing '+batch[0]+' through '+batch[batch.length-1]+' ('+(cursor+1)+'-'+Math.min(cursor+batch.length,all.length)+' of '+all.length+').';renderAll();for(i=0;i<batch.length;i++){t=batch[i];d=quoteCache[t];if(!d||!d.historyAt||(new Date().getTime()-d.historyAt)>=21600000)need.push(t)}function complete(){var end=cursor+batch.length;if(S.scanUniverse!='top100'){marketScannerBusy=false;return}S.liveScanCursor=end>=all.length?0:end;S.scannerStatus='Top 100 scan: '+Math.min(end,all.length)+' of '+all.length+' checked. '+candidates.length+' score signal(s) in this batch.';save();renderAll();marketScannerBusy=false;marketScannerTimer=setTimeout(function(){marketScannerTimer=0;scanTop100Batch()},250)}function quoteSignals(){for(i=0;i<batch.length;i++){t=batch[i];d=quoteCache[t];if(d&&(d.score>=8.5||(S.holdings[t]&&d.score<=3)))candidates.push(t)}if(!candidates.length){complete();return}fastQuoteBatch(candidates,function(){if(S.scanUniverse!='top100'){marketScannerBusy=false;return}runAutoPaperFor(candidates);complete()})}if(!need.length){quoteSignals();return}fastHistoryBatch(need,function(){if(S.scanUniverse!='top100'){marketScannerBusy=false;return}for(i=0;i<need.length;i++)if(quoteCache[need[i]])saveScore(need[i],quoteCache[need[i]]);quoteSignals()})}
function scheduleRefresh(wait){if(refreshTimer)clearTimeout(refreshTimer);if(!key())return;var delay=Number(wait)||(S.marketOpen?60000:900000);refreshTimer=setTimeout(function(){refreshAll(true)},delay);startLiveMarketScanner()}
/* Make live quote status visible on My Stocks and normalize company aliases. */
function canonicalWatchTicker(v){var t=normSymbol(String(v||'').replace(/[^A-Za-z.]/g,'')),compact=t.replace(/[^A-Z]/g,'');if(SEARCH_ALIASES&&SEARCH_ALIASES[compact])t=SEARCH_ALIASES[compact];return t}
function normalizeWatchAliases(){var old=S.watch.slice(0),next=[],seen={},i,a,b,changed=false;for(i=0;i<old.length;i++){a=old[i];b=canonicalWatchTicker(a);if(b!=a)changed=true;if(b&&!seen[b]){seen[b]=true;next.push(b);if(b!=a){if(S.holdings[a]&&!S.holdings[b])S.holdings[b]=S.holdings[a];if(S.scores[a]&&!S.scores[b])S.scores[b]=S.scores[a];if(S.history[a]&&!S.history[b])S.history[b]=S.history[a];delete S.holdings[a];delete S.scores[a];delete S.history[a]}}}if(changed){S.watch=next;save()}}
function addWatchTicker(){var e=document.getElementById('addTicker'),t=canonicalWatchTicker(e?e.value:''),i,exists=false;if(!t){if(e)e.focus();return false}for(i=0;i<S.watch.length;i++)if(S.watch[i]==t)exists=true;if(exists){e.value='';alert(t+' is already in your watchlist.');return false}S.watch.push(t);e.value='';save();renderAll();getStock(t,function(){renderAll()});return false}
function fastQuoteBatch(batch,cb){api('/quote?symbol='+batchSymbols(batch),function(err,j){var errors=[],i,t,q,d,p,open,known=false,anyOpen=false,old,hadLive;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Quote request failed.')}else for(i=0;i<batch.length;i++){t=batch[i];q=batchEntry(j,t);d=quoteCache[t];if(!q||q.status=='error'||!d){errors.push(t+': no quote');continue}p=Number(q.close||q.price||q.last);if(!isFinite(p)||p<=0){errors.push(t+': invalid quote');continue}old=Number(d.price);hadLive=d.live===true&&isFinite(old)&&old>0;d.prevPrice=hadLive?old:0;d.priceMove=hadLive?p-old:0;d.priceMovePct=hadLive?(p-old)/old*100:0;if(typeof q.is_market_open!='undefined'){known=true;open=q.is_market_open===true||String(q.is_market_open).toLowerCase()=='true';if(open)anyOpen=true;d.marketOpen=open}d.price=p;d.asOf=q.datetime||new Date().toLocaleString();d.live=true;quoteCache[t]=d}S.lastLiveError=errors.length?errors[0]:'';if(known)S.marketOpen=anyOpen;document.getElementById('marketState').innerHTML=S.marketOpen?'<span class="green">OPEN</span>':'CLOSED';document.getElementById('marketDetail').innerHTML=S.marketOpen?'Latest live quotes received':'Showing the latest available quotes';cb(errors)})}
function renderAll(){var h='',i,t,d,price,move,status,wt,summary;for(i=0;i<S.watch.length;i++)h+=stockHtml(S.watch[i],quoteCache[S.watch[i]]||null,false);document.getElementById('homeStocks').innerHTML=h||'<div class="empty">Your watchlist is empty.</div>';summary=S.lastLiveError?'<span class="red">Live quote issue: '+esc(S.lastLiveError)+'</span>':'<span class="muted">Live quotes update automatically while the market is open.</span>';wt='<div class="row space" style="margin:0 0 14px"><span>'+summary+'</span><button class="btn secondary small" onclick="refreshAll(true)">Refresh live prices</button></div><table><tr><th>Symbol</th><th>Last price</th><th>Move</th><th>Score</th><th>View</th><th></th></tr>';for(i=0;i<S.watch.length;i++){t=S.watch[i];d=quoteCache[t];price=d?money(d.price):'Waiting...';if(d&&d.live){status='<span class="blue">LIVE</span><br><span class="muted" style="font-size:.82em">'+esc(d.asOf||'Updated now')+'</span>';move=d.prevPrice&&Number(d.priceMove)!=0?'<span class="'+(d.priceMove>0?'green':'red')+'">'+(d.priceMove>0?'+':'')+money(d.priceMove)+'<br>'+(d.priceMove>0?'+':'')+Number(d.priceMovePct||0).toFixed(2)+'%</span>':'<span class="blue">Live quote</span>'}else{status='<span class="muted">Latest daily close</span>';move='<span class="muted">Waiting for live quote</span>'}wt+='<tr><td><b>'+esc(t)+'</b></td><td><b>'+price+'</b><br>'+status+'</td><td>'+move+'</td><td>'+(d?d.score.toFixed(1):'-')+'</td><td><button class="help" onclick="quickResearch(\''+esc(t)+'\')">Research</button></td><td><button class="btn secondary small" onclick="removeTicker(\''+esc(t)+'\')">Remove</button></td></tr>'}document.getElementById('watchTable').innerHTML=wt+'</table>';renderHoldings();renderWizard();renderPresets();renderTrades();renderAdvanced();document.getElementById('riskHome').innerHTML=S.risk;document.getElementById('portfolioValue').innerHTML=money(portfolioValue());wireHelpLinks()}
function init(){var hr=new Date().getHours();normalizeWatchAliases();document.getElementById('daypart').innerHTML=hr<12?'morning':hr<18?'afternoon':'evening';document.getElementById('apiKey').value=key();applyFontSize();applyMode();renderFontControl();renderAll();if(key()){setConnection('Saved key ready',true);document.getElementById('marketDetail').innerHTML='Automatic watchlist refresh is starting.';startAutomaticRefresh()}else{setConnection('Demo data',false);refreshAll()}document.getElementById('marketState').innerHTML='U.S. Market';if(!key())document.getElementById('marketDetail').innerHTML='Status follows live data availability'}
/* Fast-start quotes: show a live price before daily research finishes. */
function fastHistoryBatch(batch,cb){api('/time_series?symbol='+batchSymbols(batch)+'&interval=1day&outputsize=80',function(err,j){var errors=[],i,t,z,rows,d,old;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Daily market-data request failed.')}else for(i=0;i<batch.length;i++){t=batch[i];z=batchEntry(j,t);if(!z||z.status=='error'||!z.values){errors.push(t+': no daily history');continue}rows=z.values.slice(0);rows.sort(function(a,b){return String(a.datetime)>String(b.datetime)?-1:String(a.datetime)<String(b.datetime)?1:0});d=calc(rows);if(!d){errors.push(t+': not enough daily history');continue}d.historyAt=new Date().getTime();old=quoteCache[t];if(old&&old.live){d.price=old.price;d.prevPrice=old.prevPrice||0;d.priceMove=old.priceMove||0;d.priceMovePct=old.priceMovePct||0;d.asOf=old.asOf;d.marketOpen=old.marketOpen;d.live=true}quoteCache[t]=d;saveScore(t,d)}cb(errors)})}
function fastQuoteBatch(batch,cb){api('/quote?symbol='+batchSymbols(batch),function(err,j){var errors=[],i,t,q,d,p,open,known=false,anyOpen=false,old,hadLive,savedScore;if(err||!j||j.status=='error'){errors.push((j&&j.message)||err||'Quote request failed.')}else for(i=0;i<batch.length;i++){t=batch[i];q=batchEntry(j,t);if(!q||q.status=='error'){errors.push(t+': no quote');continue}p=Number(q.close||q.price||q.last);if(!isFinite(p)||p<=0){errors.push(t+': invalid quote');continue}d=quoteCache[t];if(!d){savedScore=Number(S.scores[t]);d={price:p,score:isFinite(savedScore)?savedScore:null,trend:'Unknown',momentum:0,vol:0,technical:0,lowrisk:0,rsi:0,sma20:p,sma50:p,drawdown:0,provisional:true}}old=Number(d.price);hadLive=d.live===true&&isFinite(old)&&old>0;d.prevPrice=hadLive?old:0;d.priceMove=hadLive?p-old:0;d.priceMovePct=hadLive?(p-old)/old*100:0;if(typeof q.is_market_open!='undefined'){known=true;open=q.is_market_open===true||String(q.is_market_open).toLowerCase()=='true';if(open)anyOpen=true;d.marketOpen=open}d.price=p;d.asOf=q.datetime||new Date().toLocaleString();d.live=true;quoteCache[t]=d}S.lastLiveError=errors.length?errors[0]:'';if(known)S.marketOpen=anyOpen;document.getElementById('marketState').innerHTML=S.marketOpen?'<span class="green">OPEN</span>':'CLOSED';document.getElementById('marketDetail').innerHTML=S.marketOpen?'Latest live quotes received':'Showing the latest available quotes';cb(errors)})}
function stockHtml(t,d,full){if(!d)return '<div class="stock"><b>'+esc(t)+'</b><span class="muted"> - Waiting for first live price</span></div>';if(d.provisional){return '<div class="stock"><div class="row space"><div><b>'+esc(t)+'</b><div class="muted">'+money(d.price)+' <span class="blue">Live</span></div><div class="muted" style="font-size:.86em">Updated '+esc(d.asOf||'now')+'</div></div><span class="pill">Loading score</span></div><div class="why"><b>Live price received.</b><br>Daily research is loading in the background. The price can update without waiting for the Adaptive Score.</div></div>'}var why=d.trend=='Positive'?'The recent price is above its 20-day average.':'The recent price is below its 20-day average.',move='',delta=Number(d.priceMove||0);if(d.live){if(d.prevPrice&&isFinite(delta)&&delta!=0)move=' <span class="'+(delta>0?'green':'red')+'">'+(delta>0?'+':'')+money(delta)+' ('+(delta>0?'+':'')+Number(d.priceMovePct||0).toFixed(2)+'%)</span>';else move=' <span class="blue">Live</span>'}return '<div class="stock"><div class="row space"><div><b>'+esc(t)+'</b><div class="muted">'+money(d.price)+move+'</div><div class="muted" style="font-size:.86em">'+(d.live?'Updated '+esc(d.asOf||'now'):'Latest daily close')+'</div></div><div class="row"><span class="pill '+signalClass(d.score)+'">'+rating(d.score)+'</span><div class="score">'+d.score.toFixed(1)+'</div></div></div><div class="why"><b>Why this score?</b><br>'+why+' Momentum is '+(d.momentum>1?'strong':d.momentum<-1?'weak':'mixed')+'. Price swings look '+(d.vol<25?'moderate':'higher than usual')+'. <button class="help" onclick="showHelp(\'score\')">What does this mean?</button></div>'+(full?'<div class="advanced-only"><table><tr><th>RSI</th><th>SMA 20</th><th>SMA 50</th><th>Volatility</th><th>Drawdown</th></tr><tr><td>'+d.rsi.toFixed(1)+'</td><td>'+money(d.sma20)+'</td><td>'+money(d.sma50)+'</td><td>'+d.vol.toFixed(1)+'%</td><td>'+d.drawdown.toFixed(1)+'%</td></tr></table></div>':'')+'</div>'}
function renderAll(){var h='',i,t,d,price,move,status,wt,summary,scoreText,allScored=true;for(i=0;i<S.watch.length;i++){d=quoteCache[S.watch[i]];if(d&&(!isFinite(Number(d.score))||d.provisional))allScored=false;h+=stockHtml(S.watch[i],d||null,false)}document.getElementById('homeStocks').innerHTML=h||'<div class="empty">Your watchlist is empty.</div>';summary=S.lastLiveError?'<span class="red">Live quote issue: '+esc(S.lastLiveError)+'</span>':'<span class="muted">Live prices appear first; scores load in the background.</span>';wt='<div class="row space" style="margin:0 0 14px"><span>'+summary+'</span><button class="btn secondary small" onclick="refreshAll(true)">Refresh live prices</button></div><table><tr><th>Symbol</th><th>Last price</th><th>Move</th><th>Score</th><th>View</th><th></th></tr>';for(i=0;i<S.watch.length;i++){t=S.watch[i];d=quoteCache[t];price=d?money(d.price):'Waiting...';if(d&&d.live){status='<span class="blue">LIVE</span><br><span class="muted" style="font-size:.82em">'+esc(d.asOf||'Updated now')+'</span>';move=d.prevPrice&&Number(d.priceMove)!=0?'<span class="'+(d.priceMove>0?'green':'red')+'">'+(d.priceMove>0?'+':'')+money(d.priceMove)+'<br>'+(d.priceMove>0?'+':'')+Number(d.priceMovePct||0).toFixed(2)+'%</span>':'<span class="blue">Live quote</span>'}else{status='<span class="muted">Waiting for first quote</span>';move='<span class="muted">Waiting for live quote</span>'}scoreText=d&&isFinite(Number(d.score))&&!d.provisional?Number(d.score).toFixed(1):'<span class="muted">Loading...</span>';wt+='<tr><td><b>'+esc(t)+'</b></td><td><b>'+price+'</b><br>'+status+'</td><td>'+move+'</td><td>'+scoreText+'</td><td><button class="help" onclick="quickResearch(\''+esc(t)+'\')">Research</button></td><td><button class="btn secondary small" onclick="removeTicker(\''+esc(t)+'\')">Remove</button></td></tr>'}document.getElementById('watchTable').innerHTML=wt+'</table>';renderHoldings();renderWizard();renderPresets();renderTrades();if(allScored)renderAdvanced();else{document.getElementById('rankings').innerHTML='<div class="empty">Live prices received. Rankings appear when daily research finishes.</div>';document.getElementById('factors').innerHTML='<div class="empty">Loading daily research...</div>';document.getElementById('evolution').innerHTML='<div class="empty">Loading daily research...</div>'}document.getElementById('riskHome').innerHTML=S.risk;document.getElementById('portfolioValue').innerHTML=money(portfolioValue());wireHelpLinks()}
function refreshAll(forceQuotes){if(refreshing)return;refreshing=true;setConnection('Getting live prices first...',false);var list=S.watch.slice(0),need=[],errors=[],i,cached,age,hi=0,qi=0;function finish(message){refreshing=false;S.lastRefresh=new Date().toLocaleString();save();if(errors.length){setConnection('Data issue',false);document.getElementById('marketDetail').innerHTML='Last refresh '+S.lastRefresh+' - '+errors[0]}else{setConnection(key()?'Live data':'Demo data',!!key());document.getElementById('marketDetail').innerHTML=message||('Refreshed '+S.lastRefresh)}renderAll();scheduleRefresh()}if(!key()){for(i=0;i<list.length;i++){cached=calc(demo(list[i]));cached.asOf='Demonstration data';cached.marketOpen=false;quoteCache[list[i]]=cached}finish('Demonstration data loaded');return}for(i=0;i<list.length;i++){cached=quoteCache[list[i]];age=cached&&cached.historyAt?(new Date().getTime()-cached.historyAt):999999999;if(!cached||age>=21600000)need.push(list[i])}function histories(){if(hi>=need.length){finish('Live prices and daily research refreshed '+S.lastRefresh);return}var batch=need.slice(hi,Math.min(hi+LIVE_BATCH_SIZE,need.length));hi+=batch.length;fastHistoryBatch(batch,function(es){for(var n=0;n<es.length;n++)errors.push(es[n]);renderAll();histories()})}function quotes(){if(qi>=list.length){setConnection('Live prices received',true);document.getElementById('marketDetail').innerHTML=need.length?'Live prices are ready. Daily research scores are loading in the background.':'Live watchlist refreshed.';renderAll();if(need.length)histories();else finish('Live watchlist refreshed '+S.lastRefresh);return}var batch=list.slice(qi,Math.min(qi+8,list.length));qi+=batch.length;fastQuoteBatch(batch,function(es){for(var n=0;n<es.length;n++)errors.push(es[n]);runAutoPaperFor(batch);quotes()})}quotes()}
function addWatchTicker(){var e=document.getElementById('addTicker'),t=canonicalWatchTicker(e?e.value:''),i,exists=false;if(!t){if(e)e.focus();return false}for(i=0;i<S.watch.length;i++)if(S.watch[i]==t)exists=true;if(exists){e.value='';alert(t+' is already in your watchlist.');return false}S.watch.push(t);e.value='';save();renderAll();getResearchStock(t,function(){renderAll()});return false}
/* Cloud paper monitor: state remains in the user's private GitHub repository. */
var CLOUD_STATE_PAGE='https://github.com/shuanhsieh/Trading-app/blob/main/cloud-monitor-state.json';
function cloudCard(){var page=document.getElementById('page-paper'),card=document.getElementById('cloudMonitorCard');if(!page)return null;if(!card){card=document.createElement('div');card.id='cloudMonitorCard';card.className='card';card.style.marginTop='16px';page.appendChild(card)}return card}
function openCloudMonitorSetup(){try{new ActiveXObject('WScript.Shell').Run('https://github.com/shuanhsieh/Trading-app/blob/main/CLOUD%20PAPER%20MONITOR%20SETUP.md',1,false)}catch(e){alert('Open the Cloud Paper Monitor Setup file included with this app package.')}}
function openCloudMonitorStatus(){try{new ActiveXObject('WScript.Shell').Run(CLOUD_STATE_PAGE,1,false)}catch(e){alert('Open cloud-monitor-state.json in your signed-in GitHub repository.')}}
function renderCloudMonitor(){var card=cloudCard();if(!card)return;card.innerHTML='<div class="row space"><div><b>Cloud paper monitor</b><div class="muted">Runs on GitHub while this Windows app is closed. Paper trades only.</div></div><div><button class="btn secondary small" onclick="openCloudMonitorStatus()">View cloud status</button><button class="help" onclick="openCloudMonitorSetup()">Setup guide</button></div></div><div class="why"><b>Private and safe</b><br>Your cloud status, simulated positions, and trade history remain in your private GitHub repository. The desktop app opens that private status page in your signed-in browser; it does not store a GitHub password or access token.<br><span class="muted">Complete the one-time GitHub Secret setup, then run the Cloud Paper Monitor workflow once to start it.</span></div>'}
var renderAllBeforeCloud=renderAll;renderAll=function(){renderAllBeforeCloud();renderCloudMonitor()};
window.onload=init;
</script>
</body></html>
